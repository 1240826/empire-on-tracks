@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Organization\nEmployee" as Employee
participant ":System" as System

activate Employee

    Employee -> System : Ask to list all the stations
    activate System

        System --> Employee : shows list of all the stations and asks to select one to see its details
    deactivate System

    Employee -> System : selects a station
    activate System

        System --> Employee : Shows station details
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success
    deactivate System
@enduml