@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as PLAYER
participant ":StationListUI" as UI
participant ":StationController" as CTRL
participant ":Map" as REPOS
participant "Map \n :Station" as REPOS_SINGLETON
participant "stationRepository\n:StationRepository" as STATION_REPO
participant "ApplicationSession" as APP_SESSION
participant "appSession\n:ApplicationSession" as APP_SESSION_SINGLETON
participant "currentSession\n:UserSession" as CURRENT_SESSION
participant "station\n:Station" as STATION

activate PLAYER

        PLAYER -> UI : requests station list
        activate UI
            UI -> CTRL : getAllStations()
            activate CTRL
                CTRL -> REPOS : getStation()
                activate REPOS
                    REPOS --> CTRL: listStation
                deactivate REPOS
                loop
                CTRL->REPOS_SINGLETON:
                end





                CTRL --> UI : displays(listStationName)
            deactivate CTRL

            UI --> PLAYER : displays station list
        deactivate UI

    PLAYER -> UI : selects a station
    activate UI
        UI -> CTRL : getStationDetails(stationId)
        activate CTRL
            CTRL -> STATION_REPO : getStationById(stationId)
            activate STATION_REPO
                STATION_REPO -> STATION : getDetails()
                activate STATION
                    STATION -> STATION : getUpgrades()
                    STATION -> STATION : getCargoes()
                    STATION --> STATION_REPO : stationDetails
                deactivate STATION
                STATION_REPO --> CTRL : stationDetails
            deactivate STATION_REPO

            CTRL --> UI : stationDetails
        deactivate CTRL

        UI --> PLAYER : shows station details\n(buildings and cargoes)
    deactivate UI

deactivate PLAYER
@enduml