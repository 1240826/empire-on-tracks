@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
'skinparam linetype orto

skinparam classAttributeIconSize 0

'left to right direction

class Player {
    - budget : double
}

class Station {
    - id : String
    - name : String
    - type : String
    - range : int
    - cost : double

    + getName()
    + getUpgrades()
    + getCargoes()
}

class Upgrade {
    - type : String
    - dateAdded : Date
    - isActive : boolean
}

class Cargo {
    - type : String
    - quantity : int
    - isSupply : boolean
}

class Map {
    + getStation()
    + getAllNamesStation()
    + getDetails()
}


class StationController {
    + StationController()
    + getAllStations()
    + getStationDetails(stationId)
    - getStationByName(name)
}

note right of StationController
    Station details are retrieved
    from selected station ID
end note



class StationListUI {
}

' Relationships
StationListUI .> StationController

StationController ..> Player
StationController ..> Station
StationController ..> Map


Map --> "*" Station : stations


Station  o--  Upgrade : upgrades
Station  o--  Cargo : cargoes



@enduml