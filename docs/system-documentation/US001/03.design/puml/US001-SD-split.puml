@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateMapUI" as UI
participant ":CreateMapController" as Controller
participant ":ValueValidator" as Validator
participant "Repositories" as Rep
participant "Repositories\n Repository" as Repos
participant "MapRepository \n: MapRepository" as Repository

participant ":Map" as Map

activate Employee

    Employee -> UI : ask to "Create a Map"
    activate UI

            UI --> Controller** : startController()



        UI --> Employee : Ask the name, width, and height







    Employee -> UI : Gives name and size


        UI --> Controller  : createMap(name, width, height)
        activate Controller

            Controller -> Validator : validateWidthLength(width, height)
            activate Validator

            Validator -> Validator : isPositiveInteger(width)
            Validator -> Validator : isPositiveInteger(height)
            Validator -> Controller : validationResult(valid or error)
            deactivate Validator

            alt If width/length are invalid
                Controller --> UI : displayError("Invalid width or heigth")


            else If width/length are valid

            ref over Controller
                 Get Map List
            end ref


                Controller -> Controller : validateMapName(name)
                Controller-->Controller:valid/invalid

                deactivate Controller

                alt If name is valid
                    UI --> Employee : asks for confirmation to create map


                    Employee -> UI : confirms map creation


                    UI -> Controller: createMap()
                    activate Controller

                    Controller->Map**:createMap(Name,whidht,height)





                            Controller -> Repository : saveMap()
                        deactivate Repository


                    Controller --> UI : displaySuccess("Map created successfully")
                else If name is invalid
                    Controller -> UI : displayError("Invalid name")
                end
            end

        deactivate Controller
    deactivate UI

@enduml
