@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateMapUI" as UI
participant ":MapValidator" as Validator
participant ":MapRepository" as Repository
participant ":Map" as Map

activate Employee

    Employee -> UI : ask to "Create a Map"
    activate UI

        UI --> Employee : Ask the name, width, and length
    deactivate UI

    Employee -> UI : Gives name, width, and length
    activate UI

        UI -> Validator : validateWidthLength(width, length)
        activate Validator

        Validator -> Validator : isPositiveInteger(width)
        Validator -> Validator : isPositiveInteger(length)
        Validator -> UI : validationResult(valid or error)

        alt If width and length are valid

        else If width or length is invalid
            UI --> Employee : displayError("Invalid width or length")
        end
        deactivate Validator

        alt If width and length are valid
            UI -> Validator : validateMapName(name)
            activate Validator

            Validator -> Repository : check if name is unique(name)
            activate Repository

                Repository --> Validator : name availability result (unique or not)
            deactivate Repository

            alt If name is unique
                Validator --> UI : name valid
            else If name is not unique
                UI -> Employee : displayError("Name is not unique")
            end
            deactivate Validator

            alt If name is valid
                UI --> Employee : asks for confirmation to create map
                activate UI

                Employee -> UI : confirms map creation
                activate UI

                UI -> Map : createMap(name, width, length)
                activate Map

                    Map --> Repository : saveMap(map)
                    activate Repository

                        Repository --> Map : map saved
                    deactivate Repository
                deactivate Map

                UI --> Employee : displaySuccess("Map created successfully")
            else If name is invalid
                UI -> Employee : displayError("Invalid name")
            end
        else If width/length is invalid
            UI -> Employee : displayError("Invalid width or length")
        end

    deactivate UI

@enduml

