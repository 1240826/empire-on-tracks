@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class CreateMapUI {

}

class CreateMapController {
  +createMapController()
  +createMap(name,width,height)
  +display(msg)
}

class ValueValidator {
  +createValueValidator()
  +isPositiveInteger(value:int)
  +validateWidthHeight(width,height)
}

class Repositories {

  -Repositories()
  +getInstance()
  +getMapRepository()
}

class MapRepository {
  +getMapNames()
  +saveMap(Map)
  +createMap(name,width,height)

}

class Map {
  -name:String
  -width:int
  -height:int
  +Map(name,width,height)
}

CreateMapUI .> CreateMapController     : uses

CreateMapController ..> MapRepository
CreateMapController ..> Repositories

CreateMapController --> ValueValidator

Repositories -->  MapRepository    : provides
MapRepository -->"*" Map             : stores

Repositories -> "1" Repositories : instance
@enduml
