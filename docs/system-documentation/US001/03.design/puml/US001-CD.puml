@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class CreateMapUI {
  +askMapInfo():MapDTO
  +confirmCreation():boolean
  +showMessage(msg:String):void
}

class CreateMapController {
  +startController():void
  +createMap(name:String,width:int,height:int):void
  +saveMap(map:Map):void
  +display(msg:String):void
}

class MapValidator {
  +isPositiveInteger(value:int):boolean
  +validateWidthHeight(width:int,height:int):boolean
}

class Repositories {
  -instance:Repositories
  -Repositories()
  +getInstance():Repositories
  +getMapRepository():MapRepository
}

class MapRepository {
  +getMapNames():List<String>
  +saveMap(map:Map):void
}

class Map {
  -name:String
  -width:int
  -height:int
  +Map(name:String,width:int,height:int)
}

CreateMapUI .> CreateMapController     : uses
CreateMapController ..> MapValidator
CreateMapController ..> MapRepository
CreateMapController .> Repositories
CreateMapController ..> Map

Repositories -->  MapRepository    : provides
MapRepository --* Map             : stores
@enduml
