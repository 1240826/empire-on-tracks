@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateMapUI" as UI
participant ":CreateMapController" as Controller

participant "Repositories" as Rep
participant "Repositories\n Repository" as Repos
participant "MapRepository \n: MapRepository" as Repository

participant ":Map" as Map

activate Employee

    Employee -> UI : ask to "Create a Map with size and name"
    activate UI

            UI --> Controller** : create()



        UI --> Employee : Ask the name, width, and height
        deactivate UI







    Employee -> UI : Gives name and size
    activate UI






            activate UI

            UI -> UI : isPositiveInteger(width)
            UI -> UI : isPositiveInteger(height)
            UI --> UI : valid
            deactivate UI
             UI --> Controller  : ValidateName(name)
             activate Controller






activate Controller
            Controller->Rep: getInstance()
            activate Rep

            Rep-->Controller:repositories
            deactivate Rep
            Controller->Repos:getMapRepository
            activate Repos
            Repos--> Controller:MapRepository
            deactivate Repos

            Controller->Repository:getMapsByName()
            activate Repository
            Repository-->Controller:listOfNames
            deactivate Repository



                Controller -> Controller : isNameUnique(name)

                Controller-->UI:valid

                deactivate Controller


                    UI --> Employee :ask for create Map confirmation
                    deactivate UI


                    Employee -> UI : confirms map creation
                    activate UI


                    UI --> Controller: createMap(name,widht,height)
                    activate Controller

                    Controller-->Map**:createMap(Name,width,height)
                    Controller->Repository:saveMap(Map)
                    activate Repository



                            Repository-->Controller:true

                        deactivate Repository
                        deactivate Controller



                    Controller --> UI : displaySuccess("Map created successfully")





        deactivate Controller

        UI-->Employee:displays operation success

    deactivate UI

@enduml