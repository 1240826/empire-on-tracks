@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateMapUI" as UI
participant ":CreateMapController" as Controller

participant "Repositories" as Rep
participant "repositories\n :Repository" as Repos
participant "mapRepository \n: MapRepository" as Repository

participant "map\n:Map" as Map

activate Employee

    Employee -> UI : ask to "Create a Map with size and name"
    activate UI

            UI --> Controller** : create()



        UI --> Employee : Ask the name, width, and height
        deactivate UI







    Employee -> UI : Gives name and size
    activate UI

             UI -> Controller  : createMap(name,width,height)
             activate Controller







            Controller->Rep: getInstance()
            activate Rep

            Rep-->Controller:repositories
            deactivate Rep
            Controller->Repos:getMapRepository
            activate Repos
            Repos--> Controller:mapRepository
            deactivate Repos

            Controller->Repository:createMap(name,width,height)
            activate Repository
            Repository-->Map**:create(name,width,height)
            activate Map
            Map->Map:ispositive(widht)
            Map->Map:ispositive(height)
            Repository-->Controller:map
            deactivate Map
            deactivate Repository





                Controller-->UI:

                deactivate Controller


                    UI --> Employee :ask for create Map confirmation
                    deactivate UI


                    Employee -> UI : confirms map creation
                    activate UI


                    UI --> Controller: saveMap()
                    activate Controller

                    Controller->Repository:saveMap(map)
                    activate Repository
                    Repository->Repository:isMapNameUnique()



                            Repository-->Controller:true

                        deactivate Repository




                    Controller --> UI :true
                    deactivate Controller





        deactivate Controller

        UI-->Employee:displays operation success

    deactivate UI

@enduml