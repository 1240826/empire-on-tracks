@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":CreateMapUI" as UI
participant ":CreateMapController" as Controller
participant ":ValueValidator" as Validator
participant "Repositories" as Rep
participant "Repositories\n Repository" as Repos
participant "MapRepository \n: MapRepository" as Repository

participant ":Map" as Map

activate Employee

    Employee -> UI : ask to "Create a Map with size and name"
    activate UI

            UI --> Controller** : create()
            activate Controller
            Controller-->Validator**:createValueValidator()



        UI --> Employee : Ask the name, width, and height







    Employee -> UI : Gives name and size


        UI --> Controller  : createMap(name, width, height)
        activate Controller

            Controller -> Validator : validateWidthLength(width, height)
            activate Validator

            Validator -> Validator : isPositiveInteger(width)
            Validator -> Validator : isPositiveInteger(height)
            Validator --> Controller : valid
            deactivate Validator







            Controller->Rep: getInstance()
            activate Rep

            Rep-->Controller:repositories
            deactivate Rep
            Controller->Repos:getMapRepository
            activate Repos
            Repos--> Controller:MapRepository
            deactivate Repos

            Controller->Repository:getMapsNames()
            activate Repository
            Repository-->Controller:listOfNames
            deactivate Repository



                Controller -> Controller : validateMapName(name)
                Controller-->Controller:valid
                Controller-->UI:displays(name and size)

                deactivate Controller


                    UI --> Employee :validates name and size confirmation


                    Employee -> UI : confirms map creation


                    UI -> Controller: createMap()
                    activate Controller

                    Controller->Repository:createMap(Name,whidht,height)
                    activate Repository

                            Repository-->Map : createMap(Name,whidht,height)
                            Repository->Repository:saveMap(Map)
                            Repository-->Repository:true
                            Repository-->Controller:Map
                        deactivate Repository



                    Controller --> UI : displaySuccess("Map created successfully")





        deactivate Controller
        UI-->Employee:displays operation success
    deactivate UI

@enduml
