@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee

    Employee -> System : ask to "Create a Map"
    activate System

        System --> Employee : Ask the name/size
    deactivate System

    Employee -> System : Gives name and size
    activate System

    System --> Employee : validates name and size confirmation
    deactivate System

     Employee -> System : confirms map creation
     activate System

     System --> Employee : displays operation success
     deactivate System

@enduml
