@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

' Classes
class AddIndustryUI {
}

class AddIndustryController {
  + startAddIndustryController()
  + submitCoordinates(x: int, y: int)
  + addIndustry(option: IndustryType)
  + displayError(message: String)
  + displayIndustryTypes(types: List<IndustryType>)
}

class ValueValidator {
  + ValidateCoordinates()
  + isPositiveInteger(value: int)
}

class Map {
  + isEmpty(x: int, y: int): boolean
  + validatePosition(x: int, y: int): boolean
  + addIndustry(option: IndustryType)
}

class IndustryRepository {
  + getListOfIndustry(): List<IndustryType>
}

class Industry {
  - Industrytype
  - ProductionType
}

' Relacionamentos com setas apropriadas
AddIndustryUI --> AddIndustryController

AddIndustryController ..> ValueValidator
AddIndustryController ..> Map
AddIndustryController ..> IndustryRepository

IndustryRepository --> "1..*" Industry : Industry
Map *-- Industry: has

@enduml
