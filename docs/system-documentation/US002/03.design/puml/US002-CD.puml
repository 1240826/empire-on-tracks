@startuml
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle

' --- Classes ---
class AddIndustryUI {
}

class AddIndustryController {
  + createAddIndustryController(Map)
  + submitCoordinates(x, y)
  + createIndustry(option)
}

class ValueValidator {
  + validateCoordinates(x, y)
  + isPositiveInteger(value)
}

class Map {
  + isEmpty(x: int, y: int): boolean
  + validatePosition(x: int, y: int): boolean
  + addIndustry(option, Location): void
}

class Repositories {
  - instance: Repositories
  + getInstance(): Repositories
  + getIndustryRepository(): IndustryRepository
}

class IndustryRepository {
  + getListOfIndustry(): List<Industry>
}

class Industry {
  - type: IndustryType
  - productionType: ProductionType
  + Industry(type: IndustryType, location: CoordinateDTO)
}

class Location {
  - posicionX: int
  - posicionY: int
  + createLocation(x: int, y: int): Location
}

' --- Relationships ---
AddIndustryUI --> AddIndustryController
AddIndustryController --> ValueValidator
AddIndustryController --> Map
AddIndustryController ..> Repositories
AddIndustryController ..> IndustryRepository
Repositories --> IndustryRepository

' AGGREGATION: IndustryRepository contains Industry
IndustryRepository "1" o-- "*" Industry

' AGGREGATION: Map contains Industry (could be composition if Map is exclusive owner)
Map "1" o-- "*" Industry

Industry --> Location

@enduml
