@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddIndustryUI" as UI
participant ":AddIndustryController" as Controller
participant ":ValueValidator" as Validator
participant ":Map" as Map
participant ":Industry" as Industry
participant "Repository" as Rep
participant "repository\n :Repository" as Repo
participant "industryRepository \n: IndustryRepository" as Repository
participant ":Location" as Location

activate Editor

Editor -> UI : Ask to add an industry
activate UI
UI --> Controller**: startAddIndustryController(Repository,Map)
activate Controller
Controller-->Validator**:createValueValidator()


UI --> Editor : Ask for the XY position
deactivate UI

Editor -> UI : Gives X,Y
activate UI
UI -> Controller : submitCoordinates(X, Y)

activate Controller
Controller->Validator:ValidateCoordinates(x,y)
activate Validator
Validator->Validator:isPositiveInteger(X)
Validator->Validator:isPositiveInteger(Y)
Validator-->Controller:valid/invalid
deactivate Validator



Controller->Map:validatePosition(X,Y)
activate Map
Map->Map:isEmpty(X,Y)
Map-->Controller:true
deactivate Map
Controller->Rep:getinstance()
activate Rep
Rep-->Controller:instance
deactivate Rep
Controller ->Repo:getindustryRepository()
activate Repo
Repo-->Controller:industryRepository
deactivate Repo
Controller->Repository:getListOfIndustry
activate Repository
Repository-->Controller:ListOfIndustry
deactivate Repository
Controller-->UI: display(ListOfIndustry)
deactivate Controller
UI-->Editor:Show the different types \nof industry and ask one option.
deactivate UI
Editor->UI:Select one option.
activate UI
UI-->Controller: createIndustry(option)
activate Controller
Controller-->Location**:createLocation(x,y)
Controller-->Map: createIndustry(option,Location)
activate Map
Map-->Industry**:createIndustry(option,Location)
Map-->Controller:Industry
deactivate Map

Controller-->UI: display(success)
deactivate Controller
deactivate Controller
UI-->Editor:Confirm the creation of this industry.
deactivate UI






deactivate Editor
@enduml
