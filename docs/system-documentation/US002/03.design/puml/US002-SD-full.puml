@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant "AddIndustryUI" as UI
participant "IndustryController" as Controller
participant "PositionValidator" as Validator
participant "IndustryRepository" as Repository
participant "IndustryFactory" as Factory
participant "Map" as Map

activate Editor

Editor -> UI : Ask to add an industry.
activate UI
UI --> Controller : startIndustryCreation()
UI --> Editor : Ask for the XY position.
deactivate UI



Editor -> UI : Gives XY
activate UI
activate Controller
UI --> Controller : provideCoordinates(X, Y)


Controller -> Validator : validateFormat(X, Y)


Validator --> Map : checkCoordinates(X, Y)
alt Invalid coordinates (out of bounds)
    Map --> Controller : false
    Controller --> UI : display("Coordinates out of bounds")
    UI --> Editor : The coordinates are invalid
    deactivate Controller


else Valid coordinates
    Map --> Controller : true

    Controller -> Repository : getIndustryTypes()
    Repository --> Controller : listOfTypes

    Controller --> UI : displayTypes(listOfTypes)
    UI --> Editor : Show the different types of industry and ask one option.
deactivate UI
    Editor -> UI : Select one option.
activate UI
    UI -> Controller : typeSelected()

    activate Controller

    Controller -> Factory** : createIndustry("Type", X, Y)

    activate Factory


    Factory --> Map : addIndustry(newIndustry)

    deactivate Factory

    Controller --> UI : display("Industry created successfully!")
    deactivate Controller
    UI -> Editor : Confirm the creation of this industry.
    deactivate UI
end


deactivate UI
deactivate Editor
@enduml
