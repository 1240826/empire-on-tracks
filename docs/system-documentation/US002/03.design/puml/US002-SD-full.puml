@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddIndustryUI" as UI
participant ":AddIndustryController" as Controller

participant ":Map" as Map
participant "industry\n:Industry" as Industry
participant "IndustryType" as Type
participant ":IndustryTypeMapper" as Mapper
participant "listIndustryType\n:List<Industry>" as list

participant "listIndustryTypeDTO\n:List<IndustryDTO>" as listDTO
participant "industryDTO\n:IndustryDTO" as objDTO


participant ":Location" as Location

activate Editor

Editor -> UI : Ask to add an industry
activate UI
UI --> Controller**: create(Map)
UI->Controller:getIndustryTypeList()
activate Controller
Controller->Type:getIndustryTypeList()
activate Type
Type-->list**:create()
Type-->Controller:listIndustryType
deactivate Type

Controller->Mapper: toDTO(listIndustryType)
activate Mapper
Mapper->listDTO**:create()
loop for each Industy in list
Mapper->list:industry=get(i)
activate list
deactivate list

Mapper->Mapper:industryDTO=toDTO(industry)
activate Mapper
Mapper-->objDTO**:create
deactivate Mapper
Mapper->listDTO:add(industryDTO)
activate listDTO
deactivate listDTO
end
Mapper-->Controller:listIndustryTypeDTO
deactivate
Controller-->UI:listIndustryTypeDTO
deactivate Controller
UI-->Editor:Show the different types of \nindustry and ask to select one .
deactivate UI
Editor->UI:Select one IndustryType.
activate UI
UI-->Editor:Ask for the X,Y position.
deactivate UI
Editor->UI:Gives positionX,positionY.
activate UI
UI->Controller:addIndustry(industryTypeDTO,positionX,positionY)
activate Controller
Controller->Map:addIndustry(industryTypeDTO,positionX,positionY)
activate Map
Map-->Industry**:create(industryTypeDTO,positionX,positionY)
activate Industry
Industry-->Location**:create(positionX,positionY)
Industry-->Map
deactivate Industry
Map-->Controller:true
deactivate Map
Controller-->UI:true
deactivate Controller
UI-->Editor:Confirm the creation of this industry








deactivate Editor
@enduml
