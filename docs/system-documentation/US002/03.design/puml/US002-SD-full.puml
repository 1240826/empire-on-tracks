@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddIndustryUI" as UI
participant ":AddIndustryController" as Controller
participant ":ValueValidator" as Validator
participant ":Map" as Map
participant "IndustryRepository \n: IndustryRepository" as Repository

activate Editor

Editor -> UI : Ask to add an industry
activate UI
UI --> Controller**: startAddIndustryController()


UI --> Editor : Ask for the XY position
deactivate UI

Editor -> UI : Gives X,Y
activate UI
UI -> Controller : submitCoordinates(X, Y)

activate Controller
Controller->Validator:ValidateCoordinates()
activate Validator
Validator->Validator:isPositiveInteger(X)
Validator->Validator:isPositiveInteger(Y)
Validator-->Controller:valid/invalid
deactivate Validator
alt Invalid
Controller-->UI: displayError(invalid coordinates)
else valid
Controller->Map:validatePosition(X,Y)
activate Map
Map->Map:isEmpty(X,Y)
Map-->Controller:true/false
deactivate Map
alt false
Controller-->UI: displayError(occupied place)
else true
Controller->Repository:getListOfIndustry
activate Repository
Repository-->Controller:ListOfIndustry
deactivate Repository
Controller-->UI: display(ListOfIndustry)
deactivate Controller
UI-->Editor:Show the different types \nof industry and ask one option.
deactivate UI
Editor->UI:Select one option.
activate UI
UI->Controller: addIndustry(option)
activate Controller
Controller->Map: addIndustry(option)
Controller-->UI: display(success)
deactivate Controller
UI-->Editor:Confirm the creation of this industry.
deactivate UI


end
end


deactivate Editor
@enduml
