@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant "AddIndustryUI" as UI
participant "IndustryController" as Controller
participant "PositionValidator" as Validator
participant "IndustryRepository" as Repository
participant "IndustryFactory" as Factory
participant "Map" as Map

activate Editor

Editor -> UI : requestIndustryCreation()
activate UI
UI -> Controller : startIndustryCreation()
deactivate UI

UI -> Editor : requestCoordinates()

Editor -> UI : provideCoordinates(X, Y)
activate UI
UI -> Controller : submitCoordinates(X, Y)

activate Controller
Controller -> Validator : validateCoordinates(X, Y)
activate Validator

Validator -> Map : checkCoordinates(X, Y)

alt Invalid coordinates
    Validator --> Controller : invalid()
    Controller -> UI : displayError("Coordinates out of bounds")
    deactivate Validator
    deactivate Controller
else Valid coordinates
    Validator --> Controller : valid()
    deactivate Validator

    Controller -> Repository : fetchIndustryTypes()
    Repository --> Controller : listOfTypes

    Controller -> UI : displayIndustryTypes(listOfTypes)
    deactivate Controller

    UI -> Editor : showOptions(listOfTypes)

    Editor -> UI : selectIndustryType(selectedTypeId)
    activate UI
    UI -> Controller : submitSelectedType(selectedTypeId)
    activate Controller

    Controller -> Factory : createIndustry(selectedTypeId, X, Y)
    activate Factory
    Factory --> Controller : newIndustry
    deactivate Factory

    Controller -> Map : addIndustry(newIndustry)
    Controller -> UI : displaySuccess("Industry created successfully!")
    deactivate Controller

    UI -> Editor : confirmCreation()
    deactivate UI
end

deactivate Editor
@enduml
