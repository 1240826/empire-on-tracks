@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddIndustryUI" as UI
participant ":AddIndustryController" as Controller

participant ":Map" as Map
participant ":Industry" as Industry
participant ":IndustryType" as Type

participant "Repositories" as Rep
participant "Repositories\n Repository" as Repos
participant "MapRepository \n: MapRepository" as Repository

participant ":Location" as Location

activate Editor

Editor -> UI : Ask to add an industry
activate UI
UI --> Controller**: createAddIndustryController(Map)
activate Controller



UI --> Editor : Ask for the X,Y position
deactivate UI

Editor -> UI : Gives positionX,positionY
activate UI




activate UI
UI->UI:isPositiveInteger(positionX)
UI->UI:isPositiveInteger(positionY)
UI-->UI:valid
deactivate UI
UI -> Controller : submitCoordinates(position X,positionY)
activate Controller




Controller->Map:validatePosition(positionX, positionY)
activate Map
Map->Map:isEmpty(positionX,positionY)
Map-->Controller:true
deactivate Map
Controller->Type:getListOfIndustry
activate Type
Type-->Controller:ListOfIndustry
deactivate Type
Controller-->UI: display(ListOfIndustry)
deactivate Controller
UI-->Editor:Show the different types \nof industry and ask to select
deactivate UI
Editor->UI:Select one Industry.
activate UI
UI->Controller: createIndustry(IndustryType,x,y)
activate Controller
Controller-->Location**:createLocation(x,y)
Controller-->Map: createIndustry(IndustryType,Location)
activate Map
Map-->Industry**:createIndustry(IndustryType,Location)

deactivate Map

            Controller->Rep: getInstance()
            activate Rep

            Rep-->Controller:repositories
            deactivate Rep
            Controller->Repos:getMapRepository
            activate Repos
            Repos--> Controller:MapRepository
            deactivate Repos

            Controller->Repository:saveMap(Map)
            activate Repository
            Repository-->Controller:true
            deactivate Repository


Controller-->UI: display(success)
deactivate Controller
deactivate Controller
UI-->Editor:Confirm the creation of this industry.
deactivate UI






deactivate Editor
@enduml
