@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Employee
participant ":System" as System

activate Employee

    Employee -> System : Select "add an industry"
    activate System

        System --> Employee : show the types of industries
    deactivate System

    Employee -> System : select "type"
    activate System

        System --> Employee : Verify if the position is valid

    deactivate System
    Employee -> System :select
        activate System

@enduml
