@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class BuyLocomotiveUI {}

class BuyLocomotiveController {
    + requestAvailableLocomotives() : LocomotiveListDTO
    + buyLocomotiveAsTrain(locomotiveID: String, trainName: String) : int
}

class LocomotiveRepository {
    + getAvailableLocomotives(currentDate: LocalDateTime) : List<Locomotive>
    + findLocomotiveById(id: String) : Locomotive
}

class PlayerRepository {
    + save(player: Player) : void
    + findById(id: String) : Player
}

class Repositories {
    - Repositories()
    + {static} getInstance() : Repositories
    + getLocomotiveRepository() : LocomotiveRepository
    + getPlayerRepository() : PlayerRepository
}

class Locomotive {
    - id : String
    - type : String
    - price : double
    - requiresElectrification : boolean
    - power : int
    - acceleration : double
    - topSpeed : double
    - startYear : int
    - fuelCostPerYear : double
    - maintenancePerYear : double
    - capacity : int
}

class Train {
    - plateNumber : String
    - name : String
    - locomotive : Locomotive
    - route : List<PointofRoute>
    - carriages : List<Carriage>
    - cargoes : List<Cargo>
    + Train(plateNumber: String, name: String, locomotive: Locomotive)
}

class Player {
    - budget : double
    - ownedTrains : List<Train>
    + hasSufficientBudget(price: double) : boolean
    + deductPrice(price: double) : void
    + createUniquePlateNumber() : String
    + addTrain(train: Train) : void
}

class LocomotiveMapper {
    + toDTO(locomotives: List<Locomotive>) : LocomotiveListDTO
    + toDTO(locomotive: Locomotive) : LocomotiveDTO
}

class LocomotiveListDTO {}
class LocomotiveDTO {}


BuyLocomotiveUI .> BuyLocomotiveController
BuyLocomotiveController .> Repositories
BuyLocomotiveController ..> LocomotiveRepository
BuyLocomotiveController ..> PlayerRepository
BuyLocomotiveController ..> LocomotiveMapper
BuyLocomotiveController ..> Player
BuyLocomotiveController ..> Locomotive
BuyLocomotiveController ..> Train

Repositories -> "1" Repositories : instance
Repositories --> "1" LocomotiveRepository : locomotiveRepository
Repositories --> "1" PlayerRepository : playerRepository

LocomotiveRepository --> "*" Locomotive : locomotives
PlayerRepository --> "*" Player : players

Player o-- "*" Train : ownedTrains
Train *-- Locomotive
LocomotiveMapper ..> LocomotiveListDTO
LocomotiveMapper ..> LocomotiveDTO

note right of BuyLocomotiveController
  train name is retrieved from inputted data
end note

note right of Player
  Responsible for:
  - budget
  - owned trains
  - unique plate generation
end note

@enduml
