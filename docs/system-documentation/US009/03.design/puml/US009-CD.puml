@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class BuyLocomotiveUI {
}

class BuyLocomotiveController {
    + requestAvailableLocomotives() : List<Locomotive>
    + buyLocomotiveAsTrain(locomotiveID: String, trainName: String) : int
}

class LocomotiveCatalog {
    + getAvailableLocomotives() : List<Locomotive>
}

class Repositories {
    + {static} getInstance() : Repositories
    + getLocomotiveCatalog() : LocomotiveCatalog
}

class Player {
    + hasSufficientBudget(price: double) : boolean
    + buyLocomotive(locomotive: Locomotive) : void
    + addTrain(train: Train) : void
}

class Locomotive {
    - id : String
    - type : String
    - price : double
    - requiresElectrification : boolean
    - power : int
    - acceleration : double
    - topSpeed : double
    - startYear : int
    - fuelCostPerYear : double
    - maintenancePerYear : double
    - capacity : int
}

class Train {
    - name : String
    - locomotive : Locomotive
    - route : List<Station>
    - cargoes : List<Cargo>
    + Train(name: String, locomotive: Locomotive, route: List<Station>, cargoes: List<Cargo>)
}

' Relationships

BuyLocomotiveUI .> BuyLocomotiveController

BuyLocomotiveController .> Repositories
BuyLocomotiveController ..> LocomotiveCatalog
BuyLocomotiveController ..> Player
BuyLocomotiveController ..> Locomotive
BuyLocomotiveController ..> Train

Repositories --> LocomotiveCatalog : locomotiveCatalog

Player  o--  Locomotive : ownedLocomotives
Player  o--  Train       : ownedTrains

LocomotiveCatalog --> "*" Locomotive : availableLocomotives

note right of BuyLocomotiveController
  Coordinates:
  - fetch catalog via Repositories
  - validate train name
  - check budget
  - buy locomotive & create Train
end note

note right of Player
  Holds budget and collections:
  - ownedLocomotives
  - ownedTrains
end note

@enduml
