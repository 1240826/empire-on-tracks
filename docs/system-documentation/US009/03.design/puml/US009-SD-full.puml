@startuml
'skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam sequenceMessageAlign center

autonumber

actor ":Player" as Player
participant ":BuyLocomotiveUI" as UI
participant ":BuyLocomotiveController" as Controller
participant "Repositories" as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant ":LocomotiveCatalog" as Catalog
participant ":Player" as PlayerObject
participant ":Train" as Train

Player -> UI : requests to buy a locomotive
activate UI

UI -> Controller : requestAvailableLocomotives()
activate Controller

Controller -> REPOS : getInstance()
activate REPOS
REPOS --> Controller : repositories
deactivate REPOS

Controller -> REPOS_SINGLETON : getLocomotiveCatalog()
activate REPOS_SINGLETON
REPOS_SINGLETON --> Controller : locomotiveCatalog
deactivate REPOS_SINGLETON

Controller -> Catalog : getAvailableLocomotives()
activate Catalog
Catalog --> Controller : list of available locomotives
deactivate Catalog

Controller --> UI : list of available locomotives
deactivate Controller

UI --> Player : shows list and requests selection
deactivate UI

Player -> UI : selects a locomotive
activate UI
UI -> Player : prompt for train name
deactivate UI
Player -> UI : enters train name
activate UI

UI -> Controller : buyLocomotiveAsTrain(locomotiveID, trainName)
deactivate UI
activate Controller


Controller -> PlayerObject : isTrainNameUnique(trainName)
activate PlayerObject
PlayerObject --> Controller : true/false
deactivate PlayerObject

alt name duplicate
    Controller --> UI : errorCode = DUPLICATE_NAME
    deactivate Controller
    activate UI
    UI --> Player : shows duplicate-name message
    deactivate UI
    activate Controller
else
    Controller -> Catalog : findLocomotiveById(locomotiveID)
    activate Catalog
    Catalog --> Controller : locomotive or null
    deactivate Catalog

    alt locomotive not found
        Controller --> UI : errorCode = NOT_FOUND
        deactivate Controller
        activate UI
        UI --> Player : shows not found message
        deactivate UI
        activate Controller
    else
        Controller -> PlayerObject : hasSufficientBudget(price)
        activate PlayerObject
        PlayerObject --> Controller : true/false
        deactivate PlayerObject

        alt insufficient budget
            Controller --> UI : errorCode = INSUFFICIENT_BUDGET
            deactivate Controller
            activate UI
            UI --> Player : shows insufficient budget message
            deactivate UI
            activate Controller
        else
            Controller -> PlayerObject : buyLocomotive(locomotive)
            activate PlayerObject
            PlayerObject --> Controller : (locomotive purchased)
            deactivate PlayerObject

            Controller -> Train : create(trainName, locomotive, ...)
            activate Train
            Controller -> PlayerObject : addTrain(newTrain)
            activate PlayerObject
            PlayerObject --> Controller : (train added)
            deactivate PlayerObject
            deactivate Train

            Controller --> UI : errorCode = SUCCESS
            deactivate Controller
            activate UI
            UI --> Player : shows success message
            deactivate UI
        end
    end
end

@enduml