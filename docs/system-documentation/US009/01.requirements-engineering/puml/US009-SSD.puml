@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : requests to buy a train
    activate System

        System --> Player : shows available locomotives and asks to select one
    deactivate System

    Player -> System : selects a locomotive
    activate System

        System --> Player : requests current date
    deactivate System

    Player -> System : enters current date
    activate System

        System --> Player : shows selected locomotive and date, requests confirmation
    deactivate System

    Player -> System : confirms selection
    activate System

        System --> Player : displays purchase success message
    deactivate System

@enduml
