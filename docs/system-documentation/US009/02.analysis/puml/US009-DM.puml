@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model for US009 - Buy a Train

class Player {
    budget
}

class Train {
    id
    acquisitionPrice
}

class Locomotive {
    type
    power
    acceleration
    topSpeed
    startYear
    acquisitionPrice
}

class Scenario {
    currentDate
    availableLocomotives
}

Player "1" -- "*" Train : owns
Train "1" - "1" Locomotive : composed of
Scenario "1" - "*" Locomotive : restricts availability

@enduml