@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model for US009 - Buy a Locomotive

class Player {
    budget
}

class Locomotive {
        plateNumber
        powerSource
        acceleration
        buyCost
        startYear
        fuelCost
        maintenanceCost
}

class Scenario {
    industryProductionRate
    behaviorOfMixedIndustries
    availableTrains
}

class Period {
    start
    end
}

Player "1" -- "*" Locomotive : buys >
Scenario "*" -- "1*" Locomotive : restricts >
Scenario "1" -- "1" Period : has >

@enduml
