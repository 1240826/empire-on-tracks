@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : asks to list all trains
    activate System

        System --> Player : displays trains grouped by locomotive type and sorted\nalphabetically, showing locomotive details and current cargoes
    deactivate System

    Player -> System : selects a train for more details
    activate System

        System --> Player : shows detailed information for the selected train
    deactivate System

    Player -> System : closes train details
    activate System

        System --> Player : returns to the train listing view
    deactivate System
@enduml