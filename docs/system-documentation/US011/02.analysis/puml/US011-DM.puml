@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model for US011 - List All Trains

class Player {
}

class List{
detail
}

class Train {
    plateNumber
    name
}

class Locomotive {
    powerSource
    acceleration
    cost
}

class Carriage {
    cargoType
    capacity
}

class Cargo {
    type
    quantity
    limit
}

class Route{
    starts
    ends
}

class Station {
    name
    range
    type
    cost
}

Player "1" -- "*" Train : owns >
Player"1"---"1" List:views >
Station "1" -- "1*" Cargo : assigned to <
Train "1" -- "1" Locomotive : composed of >
Train "1" -- "*" Carriage : composed of >
Carriage "1" -- "*" Cargo : carries >
Train"*"--right"1" List: contains <
Train "1" -- "1*" Route : follows >
Route "1" -- "2*" Station : connect >



@enduml
