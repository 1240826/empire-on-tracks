@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":CreateCityUI" as UI
participant ":CreateCityController" as Controller

activate Editor

Editor -> UI : asks to add a city
activate UI

    UI -> Controller : startCreateCity()
    activate Controller

        ref over Controller
            Get repositories and currentMap
        end ref

        Controller --> UI : requests city details\n(name, positionX, positionY, number of house blocks)
    deactivate Controller

UI --> Editor : requests city details (name, positionX, positionY, number of house blocks)
deactivate UI

Editor -> UI : types city details
activate UI

    UI -> Controller : submitCityDetails(name, positionX, positionY, houseBlocks)
    activate Controller

        ref over Controller, City
            Create city and validate name/house blocks
        end ref

        ref over Controller, Map
            isCityNameDuplicate(name)
        end ref

        alt name duplicated
            Controller --> UI : warn("City name is already in use")
        end

        Controller --> UI : requests assignment method\n(manual or automatic)
    deactivate Controller

UI --> Editor : requests to select house block assignment method (manual or automatic)
deactivate UI

Editor -> UI : selects assignment method "automatic" or "manual"
activate UI

    alt method = "automatic"
        UI -> Controller : selectedAssignmentMethod("automatic")
        activate Controller

            ref over Controller
                Automatic house block assignment
            end ref
        deactivate Controller

    else method = "manual"
        UI --> Editor : request positions of house blocks
        deactivate UI
        Editor -> UI : submits positionX, positionY
        activate UI
        UI -> Controller : selectedAssignmentMethod("manual", positions)
        activate Controller

            ref over Controller
                Validate coordinates and assignHouseBlocksManually
            end ref
        deactivate Controller
    end

    Controller --> UI : city details
deactivate UI

UI --> Editor : shows all data (city details) and requests confirmation
Editor -> UI : confirms data
activate UI

    UI -> Controller : confirmCityCreation()
    activate Controller

        ref over Controller
            Get repositories and currentMap
        end ref

        ref over Controller, Map
            addCity(city)
        end ref

        Controller --> UI : city
    deactivate Controller

    UI --> Editor : display operation success
deactivate UI

deactivate Editor
@enduml
