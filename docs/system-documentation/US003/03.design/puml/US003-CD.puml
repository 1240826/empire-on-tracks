@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class "LoginController" {
    + authenticateUser(username: String, password: String): Boolean
    - validatePassword(password: String): Boolean
}

class "User" {
    - username: String
    - password: String
}

class "PasswordValidator" {
    + validate(password: String): Boolean
}

class "ApplicationSession" {
    - ApplicationSession()
    + {static} getInstance()
    + getCurrentSession(): UserSession
}

class "UserSession" {
    + getUsername(): String
}

class "SessionManager" {
    + startSession(user: User)
    + endSession()
}

class "City" {
        - name: String
        - positionX: int
        - positionY: int
        - houseBlocks: int
        - houseBlocksList: List<HouseBlock>
        + createCity(name: String, positionX: int, positionY: int, houseBlocks: int): City
        + validateName(): boolean
        + validateHouseBlocks(): boolean
        + assignHouseBlocksManually(positions: List<Location>)
        + getCityCenter(): Location
        + addHouseBlock(houseBlock: HouseBlock): void
}

class "Location" {
    - x: int
    - y: int
    + computeBlockPosition(center: Location): Location
}

class "HouseBlock" {
    + createAt(position: Location): HouseBlock
}

class "Map" {
    + getCity(name: String): City
    + addCity(city: City)
    + isCityNameDuplicate(name: String): Boolean
    + validateCoordinates(positions: List<Location>): Boolean
}

class "Repositories" {
    - Repositories()
    + {static} getInstance(): Repositories
    + getMapRepository(): MapRepository
}

class "MapRepository" {
    + getCurrentMap(): Map
}

class "AddCityController" {
    + startAddCity()
    + submitCityDetails(name: String, positionX: int, positionY: int, houseBlocks: int)
    + selectedAssignmentMethod(method: String, positions: List<Location>)
    + confirmCityCreation()
}

class "AddCityUI" {
    + showFieldsForCityDetails() : void
    + requestCityDetails() : void
    + showWarning(message: String) : void
    + showSuccess(message: String) : void
}



LoginController ..> User : authenticates
LoginController ..> PasswordValidator : validates password
LoginController ..> ApplicationSession : manages session

ApplicationSession ..> UserSession : retrieves session
UserSession ..> User : has user

SessionManager ..> ApplicationSession : manages session lifecycle

AddCityUI .> AddCityController : submits data

AddCityController ..> Repositories : uses
AddCityController ..> MapRepository : uses
AddCityController ..> City : creates
AddCityController ..> Location : computes
AddCityController ..> HouseBlock : creates
AddCityController ..> Map : validates

Repositories -->  MapRepository : mapRepository
Repositories -->  Repositories : instance

MapRepository --> Map : currentMap

Map -->  City : cities
Map -->  Location : locations
Map -->  HouseBlock : houseBlocks

City -->  HouseBlock : houseBlocks
City -->  Location : position

HouseBlock --> Location : position

@enduml
