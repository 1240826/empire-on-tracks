@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class ApplicationSession
{
    - ApplicationSession()
    + {static} getInstance()
    + getCurrentSession()
}

class UserSession {
    + getUsername(): String
    + validate(password: String): Boolean
}

ApplicationSession ..> UserSession
ApplicationSession -> "1" ApplicationSession : instance


class "City" {
    - name: String
    - positionX: int
    - positionY: int
    - houseBlocks: int
    - houseBlocksList: List<HouseBlock>
    + createCity(name: String, positionX: int, positionY: int, houseBlocks: int): City
    + assignHouseBlocksAutomatic()
    + assignHouseBlocksManually(positions: List<Location>)
    + getCityCenter(): Location
    + getHouseBlocksCount()

}

class "Location" {
    - x: int
    - y: int
    + computeBlockPosition(center: Location): Location
}

class "HouseBlock" {
    + createAt(position: Location): HouseBlock
}

class "Map" {
    + getCity(name: String): City
    + addCity(city: City)
    + isCityNameDuplicate(name: String): Boolean
    + validateCoordinates(positions: List<Location>): Boolean
}

class "Repositories" {
    - Repositories()
    + {static} getInstance(): Repositories
    + getMapRepository(): MapRepository
}

class "MapRepository" {
    + getCurrentMap(): Map
}

class "AddCityController" {
    + startAddCity()
    + submitCityDetails(name: String, positionX: int, positionY: int, houseBlocks: int)
    + selectedAssignmentMethod(method: String, positions: List<Location>)
    + confirmCityCreation()
}

class "AddCityUI" {

}

AddCityUI .> AddCityController
AddCityController ..> Repositories : uses
AddCityController ..> MapRepository : uses
AddCityController ..> City : creates
AddCityController ..> Location : computes
AddCityController ..> HouseBlock : creates
AddCityController ..> Map : validates
AddCityController ..> ApplicationSession
AddCityController ..> UserSession

Repositories --> MapRepository : mapRepository

Repositories --> Repositories : instance


Map "1" o-- "*" City : contains
City "1" *-- "*" HouseBlock : has
City "1" --> "1" Location : centerPosition

HouseBlock "1" --> "1" Location : position

MapRepository --> Map : currentMap

@enduml
