@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":AddCityController" as Controller
participant ":Map" as Map
participant ":City" as City

autonumber 34
-> Controller : selectedAssignmentMethod("manual", positions)

autonumber 34.1

activate Controller

    group Assign Manual
        Controller -> Map : validateCoordinates(positions)
           activate Map
           Map --> Controller : valid / invalid
           deactivate Map

           alt positions valid
           Controller -> City : assignHouseBlocksManually(positions)
           activate City
                           City --> Controller : houseBlocks
                           deactivate City
           else
           <-- Controller : warn("Coordinates out of bounds")
           end
    end
    autonumber 35
    <-- Controller : city details

deactivate Controller

@enduml