@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddCityUI" as UI
participant ":AddCityController" as Controller
participant ":Map" as Map
participant ":City" as City
participant ":MapRepository" as Repository

activate Editor

    Editor -> UI : asks to add a city
    activate UI

        UI -> Controller : startAddCity()
        activate Controller

            Controller -> UI : requests city details (name, positionX, positionY, number of house blocks)
        deactivate Controller
    deactivate UI

    UI --> Editor : requests city details (name, positionX, positionY, number of house blocks)
    Editor -> UI : types city details
    activate UI

        UI -> Controller : submitCityDetails(name, positionX, positionY, houseBlocks)
        activate Controller

            Controller -> Map : getCurrentMap()
            activate Map
                Map --> Controller : currentMap
            deactivate Map

            Controller -> City : createCity(name, positionX, positionY, houseBlocks)
            activate City

                City -> City : validateName() \n(no digits or special chars)
                City -> City : validateHouseBlocks() \n(must be positive)

            deactivate City

            Controller -> Map : isCityNameDuplicate(name)
            activate Map
                Map --> Controller : true/false
            deactivate Map

            alt if name is duplicate
                Controller -> UI : warn("City name is already in use")
            else
                Controller -> UI : requests to select house block assignment method (manual or automatic)
            end
        deactivate Controller
    deactivate UI

    UI --> Editor : select assignment method
    Editor -> UI : selects assignment method
    activate UI

        alt method = "automatic"
            UI -> Controller : selectedAssignmentMethod("automatic")
            activate Controller
                Controller -> City : assignHouseBlocksAutomatically()
            deactivate Controller

        else method = "manual"
            UI -> Editor : request positions of house blocks
            Editor -> UI : submits positions
            UI -> Controller : selectedAssignmentMethod("manual", positionX, positionY)
            activate Controller

                Controller -> Map : validateCoordinates(positionX, positionY)
                activate Map
                    Map -> Controller : coordinates are valid / invalid
                deactivate Map

                alt if coordinates are valid
                    Controller -> City : assignHouseBlocksManually(positions)
                else
                    Controller -> UI : warn("Coordinates are out of bounds or invalid")
                end
            deactivate Controller
        end

        UI -> Editor : shows all data and requests confirmation
    deactivate UI

    Editor -> UI : confirms data
    activate UI

        UI -> Controller : confirmCityCreation()
        activate Controller

            Controller -> Map : addCity(city)
            activate Map

                Map -> Repository : saveCity(city)
                activate Repository
                    Repository --> Map : city saved
                deactivate Repository

            deactivate Map

            Controller -> UI : display operation success
        deactivate Controller
    deactivate UI

deactivate Editor
@enduml
