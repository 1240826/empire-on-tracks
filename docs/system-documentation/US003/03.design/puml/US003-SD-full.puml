@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":CreateCityUI"            as UI
participant ":CreateCityController"    as Controller
participant "Repositories"          as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "mapRepository\n:MapRepository" as MAP_REPO
participant ":Map"                  as Map
participant ":City"                 as City
participant ":HouseBlock"           as HouseBlock
participant ":Location"             as Location

activate Editor

Editor -> UI : asks to add a city
activate UI

    UI -> Controller : startCreateCity()
    activate Controller

        Controller -> REPOS : getInstance()
        activate REPOS
            REPOS --> Controller : repositories
        deactivate REPOS

        Controller -> REPOS_SINGLETON : getMapRepository()
        activate REPOS_SINGLETON
            REPOS_SINGLETON --> Controller : mapRepository
        deactivate REPOS_SINGLETON

        Controller -> MAP_REPO : getCurrentMap()
        activate MAP_REPO
            MAP_REPO --> Controller : currentMap
        deactivate MAP_REPO

        Controller --> UI : requests city details\n(name, positionX, positionY, number of house blocks)
    deactivate Controller
UI --> Editor : requests city details (name, positionX, positionY, number of house blocks)
deactivate UI
Editor -> UI : types city details
activate UI

    UI -> Controller : submitCityDetails(name, positionX, positionY, houseBlocks)
    activate Controller

        Controller -> City : createCity(name, positionX, positionY, houseBlocks)
        activate City
            City -> City : validateName()
            City -> City : validateHouseBlocks()
             City --> Controller : city
        deactivate City
        deactivate Controller

        Controller -> Map : isCityNameDuplicate(name)
        activate Controller
        activate Map
            Map --> Controller : true / false
        deactivate Map
        deactivate Controller

        alt name duplicated
            Controller --> UI : warn("City name is already in use")
            activate Controller
        end
            Controller --> UI : requests assignment method\n(manual or automatic)
    deactivate Controller


UI --> Editor : requests to select house block assignment method (manual or automatic)
deactivate UI
Editor -> UI : selects assignment method "automatic" or "manual"
activate UI

    alt method = "automatic"
        UI -> Controller : selectedAssignmentMethod("automatic")
        activate Controller

            Controller -> City : getCityCenter()
            activate City
                City --> Controller : center
            deactivate City

            loop houseBlocks times
                Controller -> Location : computeBlockPosition(center)
                activate Location
                    Location --> Controller : position
                deactivate Location

                Controller -> HouseBlock : createAt(position)
                activate HouseBlock
                    HouseBlock --> Controller : houseBlock
                deactivate HouseBlock

                Controller -> City : addHouseBlock(houseBlock)
                activate City
                City --> Controller : houseBlocks
                deactivate City
            end
            deactivate City
        deactivate Controller

    else method = "manual"
        UI --> Editor : request positions of house blocks
        deactivate UI
        Editor -> UI : submits positionX, positionY
        activate UI
        UI -> Controller : selectedAssignmentMethod("manual", positions)
        activate Controller

            Controller -> Map : validateCoordinates(positions)
            activate Map
                Map --> Controller : valid / invalid
            deactivate Map

            alt positions valid
                Controller -> City : assignHouseBlocksManually(positions)
                activate City
                City --> Controller : houseBlocks
                deactivate City
            else
                Controller --> UI : warn("Coordinates out of bounds")
            end
    end
    Controller --> UI: city details
            deactivate Controller

    UI --> Editor : shows all data (city details) and requests confirmation
deactivate UI

Editor -> UI : confirms data
activate UI

    UI -> Controller : confirmCityCreation()
    activate Controller

        Controller -> REPOS : getInstance()
        activate REPOS
            REPOS --> Controller : repositories
        deactivate REPOS

        Controller -> REPOS_SINGLETON : getMapRepository()
        activate REPOS_SINGLETON
            REPOS_SINGLETON --> Controller : mapRepository
        deactivate REPOS_SINGLETON

        Controller -> MAP_REPO : getCurrentMap()
        activate MAP_REPO
            MAP_REPO --> Controller : currentMap
        deactivate MAP_REPO

        Controller -> Map : addCity(city)
        activate Map
            Map -> Map : integrate city internally
Map --> Controller: city
deactivate Map
Controller --> UI: city
    deactivate Controller
    UI -->  Editor: display operation success
deactivate UI

deactivate Editor
@enduml
