@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":AddCityUI"            as UI
participant ":AddCityController"    as Controller
participant "Repositories"          as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "mapRepository\n:MapRepository" as MAP_REPO
participant ":Map"                  as Map
participant ":City"                 as City
participant ":HouseBlock"           as HouseBlock
participant ":Location"             as Location

activate Editor

Editor -> UI : asks to add a city
activate UI

    UI -> Controller : startAddCity()
    activate Controller

        Controller -> REPOS : getInstance()
        activate REPOS
            REPOS --> Controller : repositories
        deactivate REPOS

        Controller -> REPOS_SINGLETON : getMapRepository()
        activate REPOS_SINGLETON
            REPOS_SINGLETON --> Controller : mapRepository
        deactivate REPOS_SINGLETON

        Controller -> MAP_REPO : getCurrentMap()
        activate MAP_REPO
            MAP_REPO --> Controller : currentMap
        deactivate MAP_REPO

        Controller -> UI : requests city details\n(name, positionX, positionY, number of house blocks)
    deactivate Controller
deactivate UI

UI --> Editor : shows fields for city details
Editor -> UI : types name, positionX, positionY, houseBlocks
activate UI

    UI -> Controller : submitCityDetails(name, positionX, positionY, houseBlocks)
    activate Controller

        Controller -> City : createCity(name, positionX, positionY, houseBlocks)
        activate City
            City -> City : validateName()
            City -> City : validateHouseBlocks()  ' Verifica se > 0
        deactivate City

        Controller -> Map : isCityNameDuplicate(name)
        activate Map
            Map --> Controller : true / false
        deactivate Map

        alt name duplicated
            Controller -> UI : warn("City name is already in use")
        else
            Controller -> UI : requests assignment method\n(manual or automatic)
        end
    deactivate Controller
deactivate UI

UI --> Editor : select assignment method
Editor -> UI : selects "automatic" or "manual"
activate UI

    alt method = "automatic"
        UI -> Controller : selectedAssignmentMethod("automatic")
        activate Controller

            Controller -> City : getCityCenter()
            activate City
                City --> Controller : center
            deactivate City

            loop houseBlocks times
                Controller -> Location : computeBlockPosition(center)
                activate Location
                    Location --> Controller : position
                deactivate Location

                Controller -> HouseBlock : createAt(position)
                activate HouseBlock
                    HouseBlock --> Controller : houseBlock
                deactivate HouseBlock

                Controller -> City : addHouseBlock(houseBlock)
            end
        deactivate Controller

    else method = "manual"
        UI -> Editor : request positions of house blocks
        Editor -> UI : submits positions
        UI -> Controller : selectedAssignmentMethod("manual", positions)
        activate Controller

            Controller -> Map : validateCoordinates(positions)
            activate Map
                Map --> Controller : valid / invalid
            deactivate Map

            alt positions valid
                Controller -> City : assignHouseBlocksManually(positions)
            else
                Controller -> UI : warn("Coordinates out of bounds")
            end
        deactivate Controller
    end

    UI -> Editor : shows all data and asks confirmation
deactivate UI

Editor -> UI : confirms data
activate UI

    UI -> Controller : confirmCityCreation()
    activate Controller

        Controller -> REPOS : getInstance()
        activate REPOS
            REPOS --> Controller : repositories
        deactivate REPOS

        Controller -> REPOS_SINGLETON : getMapRepository()
        activate REPOS_SINGLETON
            REPOS_SINGLETON --> Controller : mapRepository
        deactivate REPOS_SINGLETON

        Controller -> MAP_REPO : addCity(city)
        activate MAP_REPO
            MAP_REPO -> MAP_REPO : saveCity(city)
        deactivate MAP_REPO

        Controller -> UI : display operation success
    deactivate Controller
deactivate UI

deactivate Editor
@enduml
