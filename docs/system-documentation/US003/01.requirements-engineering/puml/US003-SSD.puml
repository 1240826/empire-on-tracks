@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Editor" as Editor
participant ":System" as System

activate Editor

    Editor -> System : asks to add a new city
    activate System

        System --> Editor : asks for city details (name, XY position, number of house blocks)
    deactivate System

    Editor -> System : provides city details
    activate System

        System --> Editor : validates name and number of house blocks
    deactivate System

    Editor -> System : confirms city addition
    activate System

        System --> Editor : adds city and confirms operation success
    deactivate System

@enduml
