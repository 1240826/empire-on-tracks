@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false


skinparam classAttributeIconSize 0

hide circle
hide methods

class Map {
    name
}

class City {
    name
    houseBlocks
}

class Position {
    X
    Y
}

class Size {
    width
    length
}

Map "1" - "*" City : contains
City "1" - "1" Position : has
Map "1" - "1" Size : has

@enduml
