@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Organization\nEmployee" as Employee
participant ":System" as System

activate Employee

    Employee -> System : asks to create a new railway line
    activate System

        System --> Employee : shows existing stations and asks to select two of them
    deactivate System

    Employee -> System : selects two stations
    activate System

        System --> Employee : asks to select line details (i.e. if it's electrified,\nit's length, if it's single or double)
    deactivate System

    Employee -> System : selects railway line details
    activate System

        System --> Employee : shows all data and requests confirmation
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success
    deactivate System
@enduml