@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

left to right direction

hide circle
hide methods

'title Domain Model

class Editor {
}

class Map {
    name
}

class Size {
    length
    width
}

class Scenario {
    industryProductionRate
     behaviorOfMixedIndustries
     availableTrains
}

class Period {
    start
    end
}

class Cargo {
    type
    quantity
}

class Locomotive {
    plateNumber
        powerSource
        acceleration
        buyCost
        startYear
        fuelCost
        maintenanceCost
}

Editor "1" -down- "1..*" Map : creates >
Editor "1" -- "*" Scenario : creates >
Map "1" -down- "1" Size : has >
Scenario "1" -down- "1" Period : has >
Scenario "1" - "1..*" Locomotive : restricts locomotion types >
Scenario "1" - "1..*" Cargo : restricts cargo types >
Scenario "*" -down- "1" Map : uses >

@enduml
