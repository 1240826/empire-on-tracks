@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam sequenceMessageAlign center

autonumber

actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as Controller
participant "Repositories" as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "scenarioRepository\n:ScenarioRepository" as SCENARIO_REPO
participant ":Scenario" as Scenario
participant ":Cargo" as Cargo
participant ":Locomotive" as Locomotive
participant ":MapRepository" as MapRepo
participant ":Period" as Period
participant "cargoRepository\n:CargoRepository" as CargoRepo
participant "locomotiveRepository\n:LocomotiveRepository" as LocoRepo

activate Editor

Editor -> UI : asks to create a scenario for selected map
activate UI
UI --> Editor : asks to indicate a period (start and end date)
deactivate UI

Editor -> UI: introduces start and end date
activate UI
UI -> Controller : startCreateScenario(start, end)
activate Controller

Controller -> REPOS : getInstance()
activate REPOS
REPOS --> Controller : repositories
deactivate REPOS


Controller -> REPOS_SINGLETON : getScenarioRepository()
activate REPOS_SINGLETON
REPOS_SINGLETON --> Controller : scenarioRepository
deactivate REPOS_SINGLETON

Controller -> Period : newPeriod(start, end)
activate Period
Period --> Controller : period
deactivate Period
Controller -> Scenario : setPeriod(period)
deactivate REPOS_SINGLETON

UI --> Editor : shows all available locomotion types
deactivate UI

Editor -> UI : selects locomotion types to include in the scenario
activate UI

loop for each selected locomotive
    UI -> Controller : addLocomotiveType(type)
    activate Controller
    Controller -> LocoRepo : addAvailableLocomotionType(type)

    alt define availability period
        UI --> Editor : requests availability period for type
        deactivate UI
        Editor -> UI : provides availability option
        activate UI

        alt always available
            UI -> Controller : setLocomotiveAvailability(type, always)

        else never available
            UI -> Controller : skipAddingLocomotive(type)

        else from date
            UI -> Controller : setLocomotiveAvailability(type, fromDate)
            Controller -> Period : new(start, null)
            activate Period
            Period --> Controller : period
            deactivate Period
            Controller -> Locomotive : setAvailability(type, period)
            Controller -> LocoRepo : updateAvailability(type, period)
            deactivate Period

        else until date
            UI -> Controller : setLocomotiveAvailability(type, untilDate)
            Controller -> Period : new(null, end)
            activate Period
            Period --> Controller : period
            deactivate Period
            Controller -> Locomotive : setAvailability(type, period)
            Controller -> LocoRepo : updateAvailability(type, period)
            deactivate Period

        else between dates
            UI -> Controller : setLocomotiveAvailability(type, period)
            Controller -> Period : new(start, end)
            activate Period
            Period --> Controller : period
            deactivate Period
            Controller -> Locomotive : setAvailability(type, period)
            Controller -> LocoRepo : updateAvailability(type, period)
            deactivate Period
        end
    end
    deactivate Controller
end

UI --> Editor : shows all available cargo types
deactivate UI

Editor -> UI : selects cargo types to be part of the scenario (e.g., Iron, Coal, Silver, etc.)
activate UI

loop for each selected cargo
    UI -> Controller : addCargoType(cargo)
    activate Controller
    Controller -> CargoRepo : addAvailableCargo(cargo)

    UI --> Editor : requests cargo behavior (import/export/transform)
    deactivate UI
    Editor -> UI : selects behavior(s)
    activate UI

    loop for each selected behavior
        UI -> Controller : setCargoBehavior(cargo, behavior)
        activate Controller
        deactivate Controller
    end
    deactivate Controller
end

UI --> Editor : requests production frequency for industries
deactivate UI
Editor -> UI : defines production frequency (percentage)
activate UI
UI -> Controller : setIndustryProductionFrequency(percent)

UI --> Editor : shows all data and asks for confirmation
deactivate UI
Editor -> UI : confirms data
activate UI
UI -> Controller : confirmScenarioCreation()

Controller -> REPOS : getInstance()
activate REPOS
REPOS --> Controller : repositories
deactivate REPOS


Controller -> MapRepo : getMapRepository()
activate MapRepo
MapRepo --> Controller : mapRepository
deactivate MapRepo

Controller -> MapRepo : getCurrentMap()
activate MapRepo
MapRepo --> Controller : currentMap
deactivate MapRepo
Controller -> MapRepo : addScenario(scenario)
activate MapRepo
MapRepo -> MapRepo : integrate scenario internally
deactivate MapRepo

Controller -> SCENARIO_REPO : saveScenario(scenario)
activate SCENARIO_REPO
SCENARIO_REPO -> SCENARIO_REPO : storeScenario(scenario)
deactivate SCENARIO_REPO

Controller --> UI : scenario creation result (success)
UI --> Editor : shows operation success confirmation

deactivate SCENARIO_REPO
deactivate MapRepo
deactivate REPOS
deactivate Controller
deactivate UI
deactivate Editor
@enduml
