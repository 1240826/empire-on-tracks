@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam sequenceMessageAlign center

autonumber

actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as CTRL
participant "map\n:Map" as Map
participant "scenario\n:Scenario" as Scenario
participant "period\n:Period" as Period
participant "LocomotiveType" as LocomotiveType
participant "IndustryMapper" as IndustryMapper
participant "listIndustry\n:List<Industry>" as ListIndustry
participant "listIndustryDTO\n:List<IndustryDTO>" as ListIndustryDTO
participant "industryDTO\n:IndustryDTO" as IndustryDTO
participant "industry\n:Industry" as Industry


activate Editor

Editor -> UI : asks to create a scenario
activate UI
    UI --> CTRL **: create(map)
UI --> Editor : requests scenario name and period (start and end date)
deactivate UI
Editor -> UI : provides name, start and end date
activate UI
UI -> CTRL: createScenario(name, startDate,endDate)
activate CTRL
CTRL -> Map: createScenario(name, startDate,endDate)
activate Map
Map --> Scenario**: create(name, startDate,endDate)
activate Scenario
Scenario --> Period**: create(startDate,endDate)

deactivate Scenario
Map --> CTRL:
deactivate Map
CTRL --> UI:
deactivate CTRL
UI --> Editor: show options and asks to select one
deactivate UI

alt locomotive
Editor -> UI: select locomotive types to include in the scenario
activate UI
UI -> CTRL: getLocomotiveTypes()
activate CTRL
CTRL -> LocomotiveType: getLocomotiveTypes()
activate LocomotiveType
LocomotiveType --> CTRL: locomotive types
deactivate LocomotiveType
CTRL --> UI: locomotive types
deactivate CTRL
UI --> Editor : shows all available locomotion types
deactivate UI
Editor -> UI: defines available types
activate UI
UI -> CTRL: defineAvailableTypes(type)
activate CTRL
CTRL -> Map: defineAvailableTypes(type)
activate Map
Map -> Scenario: defineAvailableTypes(type)
activate Scenario
Scenario --> Map: true
deactivate Scenario
Map --> CTRL: true
deactivate Map
CTRL --> UI: true
deactivate CTRL
UI --> Editor: success
deactivate UI

else production rate
Editor -> UI: select production rates to include in the scenario
activate UI
UI -> CTRL: getIndustries()
activate CTRL
CTRL -> Map: getIndustries()
activate Map
Map --> ListIndustry**:
Map --> CTRL: listIndustry
deactivate Map
CTRL -> IndustryMapper: toDTO(listIndustry)
activate IndustryMapper
IndustryMapper --> ListIndustryDTO**: create()
loop for each industry in list
IndustryMapper -> ListIndustry: industry=get(i)
activate ListIndustry
deactivate ListIndustry
IndustryMapper -> IndustryMapper: industryDTO=t0DTO(industry)
activate IndustryMapper
IndustryMapper --> IndustryDTO** : create(industry)
deactivate IndustryMapper
IndustryMapper -> ListIndustryDTO: add(IndustryDTO)
activate ListIndustryDTO
deactivate ListIndustryDTO
end
IndustryMapper --> CTRL: listIndustryDTO
deactivate IndustryMapper
CTRL --> UI: listIndustryDTO
deactivate CTRL
UI --> Editor: shows list

deactivate UI
Editor -> UI: select industry and define production rate
loop for each industry
activate UI
UI -> CTRL: defineProductionRate(rate, IndustryDTO)
activate CTRL
CTRL -> Map: defineProductionRate(rate, IndustryDTO)
activate Map
Map -> Scenario: defineProductionRate(rate, IndustryDTO)
activate Scenario
Scenario --> Map: true
deactivate Scenario
Map --> CTRL: true
deactivate Map
CTRL --> UI: true
deactivate CTRL
UI --> Editor: success
deactivate UI
end
else mixed behavior
Editor -> UI: selects mixed behavior
activate UI
UI --> Editor: show options menu (import/export/transform)
deactivate UI
Editor -> UI: selects behavior
activate UI
UI -> CTRL: selectBehavior(behavior)
activate CTRL
CTRL -> Map: selectBehavior(behavior)
activate Map
Map -> Scenario: selectBehavior(behavior)
activate Scenario
Scenario --> Map: true
deactivate Scenario
Map --> CTRL: true
deactivate Map
CTRL --> UI: true
deactivate CTRL
UI --> Editor : displays operation success
deactivate UI

end
@enduml
