@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam sequenceMessageAlign center

autonumber

actor "Editor" as Editor
participant ":CreateScenarioUI" as UI
participant ":CreateScenarioController" as Controller
participant "Repositories" as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "scenarioRepository\n:ScenarioRepository" as SCENARIO_REPO
participant ":Scenario" as Scenario
participant ":Cargo" as Cargo
participant ":Locomotive" as Locomotive
participant ":MapRepository" as MapRepo
participant ":Period" as Period
participant "cargoRepository\n:CargoRepository" as CargoRepo
participant "locomotiveRepository\n:LocomotiveRepository" as LocoRepo

activate Editor

Editor -> UI : asks to create a scenario for selected map
activate UI

UI -> Controller : startCreateScenario(start, end)
activate Controller

Controller -> REPOS : getInstance()
activate REPOS
REPOS --> Controller : repositories
deactivate REPOS

Controller -> REPOS_SINGLETON : getScenarioRepository()
activate REPOS_SINGLETON
REPOS_SINGLETON --> Controller : scenarioRepository
deactivate REPOS_SINGLETON

Controller -> Period : newPeriod(start, end)
activate Period
Period --> Controller : period
deactivate Period
Controller -> Scenario : setPeriod(period)

deactivate scenario
deactivate Period
deactivate REPOS_SINGLETON

UI --> Editor : requests available locomotion types (diesel, electric, steam)
Editor -> UI : indicates locomotion types to include in the scenario
UI -> Controller : submitLocomotionTypes(types)
activate Controller

opt add locomotives
    Controller -> REPOS : getInstance()
    activate REPOS
    REPOS --> Controller : repositories
    deactivate REPOS

    Controller -> LocoRepo : getAllLocomotives()
    activate LocoRepo
    LocoRepo --> Controller : allLocomotives
    deactivate LocoRepo

    loop for each selected locomotive
        Controller -> LocoRepo : addAvailableLocomotive(locomotive)
    end
end

opt remove locomotives
    loop for each locomotive to remove
        Controller -> LocoRepo : removeAvailableLocomotive(locomotive)
    end
end

deactivate Controller

alt locomotion type becomes obsolete during scenario period
    UI --> Editor : requests obsolescence date for locomotion type
    Editor -> UI : provides obsolescence date
    alt "never obsolete"
        UI -> Controller : setLocomotionObsolescence(type, "never")
        activate Controller
        Controller -> LocoRepo : addAvailableLocomotionType(type)
        deactivate Controller
    else "immediately obsolete"
        UI -> Controller : setLocomotionObsolescence(type, "immediately")
        activate Controller
        Controller -> LocoRepo : removeAvailableLocomotionType(type)
        deactivate Controller
    else "period"
        UI -> Controller : setLocomotionObsolescence(type, "period")
        activate Controller
        Controller -> UI : request period
        UI -> Controller : provide period(start, end)
        Controller -> Period : new(start, end)
        activate Period
        Period --> Controller : period
        deactivate Period
        Controller -> Locomotive : setObsolescence(type, period)
        activate Locomotive
        Controller -> LocoRepo : updateAvailability(type, period)
        deactivate Locomotive
        deactivate Controller
    end
end

UI --> Editor : requests cargo types to be part of the scenario
Editor -> UI : defines cargo types to be part of the scenario (Iron, Coal, Silver, etc.)
UI -> Controller : submitCargoTypes(types)
activate Controller

Controller -> Cargo : setTypes(types)
activate Cargo

loop for each selected cargo
    UI --> Editor : requests cargo behavior (import/export/transform)
    Editor -> UI : defines behavior(s) for cargo
    loop for each selected behavior
        UI -> Controller : setCargoBehavior(cargo, behavior)
        activate Controller
        deactivate Controller
    end
end

deactivate Cargo

deactivate Controller

UI --> Editor : requests production frequency for generating industries
Editor -> UI : defines production frequency for generating industries (as a percentage)
UI -> Controller : setIndustryProductionFrequency(percent)
activate Controller
deactivate Controller

UI --> Editor : shows all data and asks for confirmation
Editor -> UI : confirms data
UI -> Controller : confirmScenarioCreation()
activate Controller

Controller -> REPOS : getInstance()
activate REPOS
REPOS --> Controller : repositories

Controller -> MapRepo : getMapRepository()
activate MapRepo
MapRepo --> Controller : mapRepository

Controller -> MapRepo : getCurrentMap()
activate MapRepo
MapRepo --> Controller : currentMap

deactivate MapRepo

Controller -> MapRepo : addScenario(scenario)
activate MapRepo
MapRepo -> MapRepo : integrate scenario internally

deactivate MapRepo

Controller -> SCENARIO_REPO : saveScenario(scenario)
activate SCENARIO_REPO
SCENARIO_REPO -> SCENARIO_REPO : storeScenario(scenario)
deactivate SCENARIO_REPO

deactivate REPOS

Controller -> UI : displays operation success
deactivate Controller
deactivate UI
deactivate Editor

@enduml
