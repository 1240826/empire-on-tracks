@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class LoginController {
    + authenticateUser(username: String, password: String): Boolean
    - validatePassword(password: String): Boolean
}

class User {
    - username: String
    - password: String
}

class PasswordValidator {
    + validate(password: String): Boolean
}

class ApplicationSession {
    - ApplicationSession()
    + getInstance()
    + getCurrentSession(): UserSession
}

class UserSession {
    + getUsername(): String
}

class SessionManager {
    + startSession(user: User)
    + endSession()
}

LoginController ..> User
LoginController ..> PasswordValidator
LoginController ..> ApplicationSession
ApplicationSession ..> UserSession
UserSession ..> User
SessionManager ..> ApplicationSession


class CreateScenarioUI {

}

class CreateScenarioController {
    + startCreateScenario(start: Date, end: Date)
    + addLocomotiveType(type: String)
    + setLocomotiveAvailability(type: String, period: Period)
    + addCargoType(cargo: String)
    + setCargoBehavior(cargo: String, behavior: String)
    + setIndustryProductionFrequency(percent: int)
    + confirmScenarioCreation(): boolean
}

CreateScenarioUI .> CreateScenarioController


class Scenario {
    - locomotives: List<Locomotive>
    - cargos: List<Cargo>
    - period: Period
    + setPeriod(period: Period)
    + addLocomotive(year: int, type: String)
    + addCargo(cargo: Cargo)
}

class Period {
    - startDate: Date
    - endDate: Date
    + new(start: Date, end: Date)
}

class Cargo {
    - type: String
    - quantity: int
    - behaviors: List<String>
    + setBehavior(behavior: String)
}

class Locomotive {
     - plateNumber: String
     - powerSource: String
     - acceleration: double
     - buyCost: double
     - startYear: int
     - fuelCost: double
     - maintenanceCost: double
     + setAvailability(period: Period)
}

class Repositories {
    - instance: Repositories
    + getInstance(): Repositories
    + getScenarioRepository(): ScenarioRepository
    + getCargoRepository(): CargoRepository
    + getLocomotiveRepository(): LocomotiveRepository
    + getMapRepository(): MapRepository
}

class ScenarioRepository {
    + saveScenario(scenario: Scenario)
}

class CargoRepository {
    + addAvailableCargo(cargo: Cargo)
}

class LocomotiveRepository {
    + addAvailableLocomotionType(type: String)
    + updateAvailability(type: String, period: Period)
}

class MapRepository {
    + getCurrentMap(): Map
}

CreateScenarioController ..> Repositories
CreateScenarioController ..> ScenarioRepository
CreateScenarioController ..> CargoRepository
CreateScenarioController ..> LocomotiveRepository
CreateScenarioController ..> Period
CreateScenarioController ..> Scenario
CreateScenarioController ..> Cargo
CreateScenarioController ..> Locomotive


Repositories --> "1" ScenarioRepository : scenarioRepository
Repositories --> "1" CargoRepository : cargoRepository
Repositories --> "1" LocomotiveRepository : locomotiveRepository
Repositories --> "1" MapRepository : mapRepository

Scenario o-- "*" Locomotive : locomotives
Scenario o-- "*" Cargo : cargos
Scenario o-- "1" Period : period

Locomotive --> "1" Period : available

@enduml
