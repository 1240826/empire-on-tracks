@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

' AUTENTICAÇÃO
class "LoginController" {
    + authenticateUser(username: String, password: String): Boolean
    - validatePassword(password: String): Boolean
}

class "User" {
    - username: String
    - password: String
}

class "PasswordValidator" {
    + validate(password: String): Boolean
}

class "ApplicationSession" {
    - ApplicationSession()
    + {static} getInstance()
    + getCurrentSession(): UserSession
}

class "UserSession" {
    + getUsername(): String
}

class "SessionManager" {
    + startSession(user: User)
    + endSession()
}

LoginController ..> User
LoginController ..> PasswordValidator
LoginController ..> ApplicationSession
ApplicationSession ..> UserSession
UserSession ..> User
SessionManager ..> ApplicationSession

' CENÁRIO
class "Scenario" {
    - period: Period
    - locomotionTypes: List<LocomotionType>
    - cargoTypes: List<CargoType>
    - productionFrequency: float
    + setPeriod(p: Period)
    + setLocomotionTypes(types: List<LocomotionType>)
    + setCargoTypes(types: List<CargoType>)
    + setProductionFrequency(frequency: float)
}

class "LocomotionType" {
    - name: String
    - availabilityPeriod: Period
    - obsolescencePeriod: Period
    + setAvailability(period: Period)
    + setObsolescence(period: Period)
}

class "CargoType" {
    - name: String
    - behaviors: List<CargoBehavior>
    + setBehaviors(behaviors: List<CargoBehavior>)
}

class "CargoBehavior" {
    - type: String «import | export | transform»
}

class "Period" {
    - startDate: String
    - endDate: String
    + Period(start: String, end: String)
}

class "ScenarioController" {
    + startCreateScenario()
    + submitScenarioPeriod(start: String, end: String)
    + submitLocomotionTypes(types: List<String>)
    + setLocomotionAvailability(type: String, period: Period)
    + setLocomotionObsolescence(type: String, period: Period)
    + submitCargoTypes(types: List<String>)
    + setCargoBehavior(type: String, behavior: String)
    + setIndustryProductionFrequency(percent: float)
    + confirmScenarioCreation(): boolean
}

class "ScenarioUI" {
    + showScenarioFields()
    + requestScenarioDetails()
    + showWarning(message: String)
    + showSuccess(message: String)
}

class "ScenarioRepository" {
    + getCurrentScenario(): Scenario
    + saveScenario(s: Scenario)
}

class "MapRepository" {
    + getCurrentMap(): Map
    + addScenario(scenario: Scenario)
}

class "Map" {
    - name: String
    - scenarios: List<Scenario>
}

' Relações
ScenarioController ..> Scenario
ScenarioController ..> Period
ScenarioController ..> LocomotionType
ScenarioController ..> CargoType
ScenarioController ..> ScenarioRepository
ScenarioController ..> MapRepository
ScenarioController .down.> ScenarioUI : uses

Scenario ..* LocomotionType
Scenario ..* CargoType
CargoType ..* CargoBehavior
MapRepository --> Map
Map o-- "*" Scenario

ScenarioUI .> ScenarioController

@enduml
