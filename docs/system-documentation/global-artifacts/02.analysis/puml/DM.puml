@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Railway Map Management - Domain Model

class Editor {
}

class Player {
budget
}

class Map {
    name
}
class Size{
    length
    width
}

class Industry {
    production
}
class PrimarySectorIndustry{
    type
}
class TransformingIndustry{
    type
    demand
}
class MixedIndustry{
    type
}

class City {
    numberOfHouseBlocks
    name
}
class HouseBlock{
    people
}

class Scenario {
    behaviorOfMixedIndustries
    locomotionType
    portCargoBehavior
}
class Period {
    start
    end
}

class Location{
    positionX
    positionY
}

class Station {
    name
    range
    type
    cost
}

class Train{
   plateNumber
}
class RailLine{
cost
type
}
class StationUpgrade{
      structure
}
class Route{
    starts
    ends
}

class Simulator{
isRunning
}

class Cargo {
    type
    quantity
    limit
}
class Locomotive {
    powerSource
    acceleration
    cost
}

class Carriage{
    cargoType
    capacity
    }

class List{
detail
}


' Ajustando as posições das classes

Editor "1" -down- "1*" Map : creates >
Editor "1" -- "*" Scenario : creates >
Editor "1" -right- "*" City : adds >
Editor "1" -- "*" Industry : adds >

Player "1" -right- "1*" Station : buys >
Player "1" -down- "1" Map : places elements >
Player "1" -- "1*" Train : buys >
Player "1" - "1*" RailLine : builds >
Player "1"---"*" StationUpgrade: buys >
Player"1"---"1" List:views >

Map "1" - "1" Size : has >
Map "1" -- "*" Industry : contains >
Map "1" -- "*" City : contains >
Map "1" -- "*" RailLine : contains >

Industry "1*" -down- "1*" PrimarySectorIndustry : could be >
Industry "1*" -down- "1*" TransformingIndustry : could be >
Industry "*" -down- "1*" MixedIndustry : could be >
Industry "1" - "1" Location : has >
Industry "1*" -- "1*" Station : load/unload >
Industry "1" -- "1*" Cargo : produces >

Scenario "1" -- "1" Period : has >
Scenario "*" -- "1*" MixedIndustry : changes Class >
Scenario "*" -- "1*" Industry : changes Production >
Scenario "*" - "1" Map : uses >
Scenario "*" - "1*" Train : restrict >

MixedIndustry "*" -down- "*" PrimarySectorIndustry : transforms >
MixedIndustry "*" -down- "*" TransformingIndustry : transforms >

Station "1" -- "1" Location : has >
Station "1" - "1" RailLine : connects <
Station "1" -left- "*" StationUpgrade : upgrades <
Station "1*" -- "1*" Train : Load/unload <
Station "1*" --- "1*" City : Load/unload >
Station "1" -- "1*" Cargo : assigned to <
Station "*"--- "1"List: contain <

Train "1" -- "1*" RailLine : uses >
Train "1" -- "1*" Route : follows >
Train "1" -- "1" Locomotive : composed of >
Train "1" -- "*" Carriage : composed of >
Train"*"--right"1" List: contains <


Route "1" -- "1*" RailLine : use >
Route "1" -- "2*" Station : connect >

City "1" -- "1*" HouseBlock : contains >
City "1" -- "1" Location : bears >

Simulator "1" -- "1*" Industry : start/pause >

@enduml

