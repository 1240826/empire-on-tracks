@startuml
skinparam monochrome true
@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Railway Map Management - Domain Model

class Editor {
    email
    login
}

class Player {
    email
    login
}

class Map {
    name

}
class Size{
    width
    height
}

class Industry {
    production
}
class PrimarySectorIndustries{
    type

}
class TransformingIndustries{
    type
    demand
}
class  MixedIndustries{
    type
}

class City {
    numberOfHouseBlocks
    name
}
class HouseBlocks{
    people
}

class Scenario {
    time
    behaviorOfMixedIndustries
    availableLocomotive
    changeProduction

}

class Location{
    positionX
    positionY

}

class Station {
    name
    range
}







' --- Relacionamentos ---
Player "1" -- "1*" Station: buy >
Player "1" -- "1" Map: add builds >

Editor "1" -- "1*" Map: creates >
Editor "1" -- "*" Scenario: creates >
Editor "1" -- "1*" City: add >
Editor "1" -- "1*" Industry: adds >

Station "1*" - "1" Location: have >

Map "1" -- "1" Size: have >
Map "1" -- "1*" Industry: contains >
Map "1"-- "1*"City: contains >

Industry "1" --- "1" PrimarySectorIndustries: could be >
Industry "1" --- "1" TransformingIndustries: could be >
Industry "1" --- "1" MixedIndustries: could be >
Industry "1*" --- "1" Location: have >

MixedIndustries "1" -- "1" TransformingIndustries: transforms >
MixedIndustries "1" -- "1" PrimarySectorIndustries: transforms >

Scenario "1" -- "*" MixedIndustries: changes Class >
Scenario "1" -- "*" Industry: changes Production >

