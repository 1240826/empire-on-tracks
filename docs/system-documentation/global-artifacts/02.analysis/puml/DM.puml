@startuml
skinparam monochrome true
@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Railway Map Management - Domain Model

class Editor {
    email
    login
}

class Player {
    email
    login
}

class Map {
    name
    width
    height
}

class Industry {
    positionX
    positionY
}

class City {
    name
    houseBlocks
    positionX
    positionY
}

class Scenario {
    availableLocomotives
    portBehaviors
    industryGenerationFactors
}

class PortBehavior {
    imports
    exports
    transformations
}

class Station {
    name
    type
    positionX
    positionY
}

class StationUpgrades {
}

class RailwayLine {
    startStation
    endStation
}

class Locomotive {
    type
    name
    availableFrom
}

class Train {
    name
    locomotive
    currentCargoes
}

class Cargo {
    type
    origin
    destination
}

class Simulator {
    isRunning
    cargoGenerationRules
}

' --- Relacionamentos ---
Editor "1" -- "*" Map : creates >
Player "1" -- "*" Station : builds >
Player "1" -- "*" RailwayLine : constructs >
Player "1" -- "*" Train : manages >

Map "1" -- "*" Industry : contains >
Map "1" -- "*" Station : contains >
Map "1" -- "*" City : contains >
Map "1" -- "*" Scenario : has >

Scenario "1" -- "*" PortBehavior : defines >
Scenario "1" -- "*" Locomotive : allows >


Station "1" -- "*" StationUpgrades : upgrades >
Station "1" -- "*" RailwayLine : connectedVia >
RailwayLine "1" -- "*" Train : usedBy >

Train "1" -- "*" Cargo : carries >
Simulator "1" -- "*" Cargo : generates >

@enduml