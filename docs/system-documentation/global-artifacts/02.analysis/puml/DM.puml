@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Railway Map Management - Domain Model

class Editor {
}

class Player {
}

class Map {
    name
}
class Size{
    width
    height
}

class Industry {
    production
}
class PrimarySectorIndustries{
    type
}
class TransformingIndustries{
    type
    demand
}
class MixedIndustries{
    type
}

class City {
    numberOfHouseBlocks
    name
}
class HouseBlocks{
    people
}

class Scenario {
    year
    behaviorOfMixedIndustries
    availableTrains
    changeProduction
}

class Location{
    positionX
    positionY
}

class Station {
    name
    range
    type
}

class Trains{
     type
     speed
     cargo
}
class RailLines{
}
class StationUpgrades{
      structure
}
class Routes{
    starts
    ends
}

class Simulator{
}

class Cargo {
    type
    quantity
}

' Ajustando as posições das classes

Editor "1" -down- "1*" Map : creates >
Editor "1" -- "1*" Scenario : creates >
Editor "1" -right- "1*" City : add >
Editor "1" -- "1*" Industry : add >

Player "1" --right- "1*" Station : buy >
Player "1" -down- "1" Map : "add builds" >
Player "1" -- "1*" Trains : buy >
Player "1" - "1*" RailLines : build >

Map "1" - "1" Size : has >
Map "1" -- "1*" Industry : contains >
Map "1" -- "1*" City : contains >
Map "1" -- "1*" RailLines : contains >

Industry "1*" -- "1*" PrimarySectorIndustries : could be >
Industry "1*" -- "1*" TransformingIndustries : could be >
Industry "1*" -- "1*" MixedIndustries : could be >
Industry "1" - "1" Location : have >
Industry "1*" -- "1*" Station : load/unload >
Industry "1" -- "1*" Cargo : produces >

Scenario "*" -- "1*" MixedIndustries : changes Class >
Scenario "*" -left- "1*" Industry : changes Production >
Scenario "*" - "1" Map : have >
Scenario "*" - "1*" Trains : restrict >

MixedIndustries "*" -down- "*" PrimarySectorIndustries : transforms >
MixedIndustries "*" -down- "*" TransformingIndustries : transforms >

Station "1" -- "1" Location : has >
Station "1" - "1" RailLines : connect <
Station "1" -right- "*" StationUpgrades : upgrade <
Station "1*" -- "1*" Trains : Load/unload <
Station "1*" --- "1*" City : Load/unload <
Station "1" -- "1*" Cargo : assigned to <

Trains "1" -- "1*" RailLines : use >
Trains "1" -- "1*" Routes : follow >

Routes "1" -- "1*" RailLines : use >
Routes "1" -- "2*" Station : connect >

City -- HouseBlocks : contains >
City "1" -- "1" Location : has >

Simulator "1" -- "1*" Industry : changes >

@enduml

