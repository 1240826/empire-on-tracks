@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods


class Editor {
}

class Player {
budget
}

class Map {
    name
}
class Size{
    length
    width
}

class Industry {
    production
}
class PrimarySectorIndustry{
    type
}
class TransformingIndustry{
    type
    demand
}
class MixedIndustry{
    type
}

class City {
    name
}
class HouseBlock{
    people
}

class Scenario {
    behaviorOfMixedIndustries
    locomotiveType
    industryProductionRate
}
class Period {
    start
    end
}

class Location{
    positionX
    positionY
}

class Station {
capacity
    name

}

class StationType{
   range
   cost
}

class Train{
   plateNumber
   name
}
class RailLine{
cost
type
}
class StationStructure{

}
class Route{
    starts
    ends
}

class Simulation{
isRunning
}

class Cargo {
    type
    quantity
    limit
}
class Locomotive {
    powerSource
    acceleration
    cost
}

class Carriage{
    cargoType
    capacity
    }




' Ajustando as posições das classes

Editor "1" -down- "1..*" Map : creates >
Editor "1" -- "*" Scenario : creates >
Editor "1" -right- "*" City : adds >
Editor "1" -- "*" Industry : adds >

Player "1" -- "1..*" Station : buys >
Player "1" - "1" Map : places elements >
Player "1" -- "1..*" Train : buys >
Player "1" - "1..*" RailLine : builds >
Player "1"-"*" StationStructure: buys >


Map "1" - "1" Size : has >
Map "1" -- "*" Industry : contains >
Map "1" -- "*" City : contains >
Map "1" -- "*" RailLine : contains >

Industry "1..*" -down-> "1..*" PrimarySectorIndustry : can be >
Industry "1..*" -down-> "1..*" TransformingIndustry : can be >
Industry "*" -down-> "1..*" MixedIndustry : can be >
Industry "1" - "1" Location : has >
Industry "1..*" -- "1..*" Station : loads/unloads >
Industry "1" -- "1..*" Cargo : produces >

Scenario "1" -- "1" Period : has >
Scenario "*" -- "1..*" MixedIndustry : changes Class >
Scenario "*" -- "1..*" Industry : changes Production >
Scenario "*" - "1" Map : uses >
Scenario "*" - "1..*" Train : restricts >

MixedIndustry "*" -down-> "*" PrimarySectorIndustry : transforms >
MixedIndustry "*" -down-> "*" TransformingIndustry : transforms >

Station "1" -- "1" Location : has >
Station "1" - "1" RailLine : connects <
Station "1" -- "*" StationStructure : upgrades <
Station "1..*" -- "1..*" Train : loads/unloads <
Station "1..*" --- "1..*" City : loads/unloads >
Station "1" -- "1..*" Cargo : is assigned to <
Station "1"-->"1" StationType:could be >


Train "1" -- "1..*" RailLine : uses >
Train "1" -- "1..*" Route : follows >
Train "1" -- "1" Locomotive : is composed of >
Train "1" -- "*" Carriage : is composed of >



Route "1" -- "1..*" RailLine : uses >
Route "1" -- "2*" Station : connects >

City "1" -- "1..*" HouseBlock : contains >
City "1" -- "1" Location : bears >

Simulation "1" -- "1..*" Industry : starts/pauses >
Simulation "1" -- "1..*" City : starts/pauses >
@enduml

