@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

'title Railway Map Management - Domain Model

class Editor {
}

class Player {
budget
}

class Map {
    name
}
class Size{
    length
    width
}

class Industry {
    production
}
class PrimarySectorIndustries{
    type
}
class TransformingIndustries{
    type
    demand
}
class MixedIndustries{
    type
}

class City {
    numberOfHouseBlocks
    name
}
class HouseBlocks{
    people
}

class Scenario {
    year
    behaviorOfMixedIndustries
    availableTrains
    changeProduction
}

class Location{
    positionX
    positionY
}

class Station {
    name
    range
    type
    cost
}

class Trains{
   plateNumber
}
class RailLines{
cost
type
}
class StationUpgrade{
      structure
}
class Routes{
    starts
    ends
}

class Simulator{
isRunning
}

class Cargo {
    type
    quantity
    limit
}
class Locomotive {
    powerSource
    acceleration
    cost
}

class Carriage{
    cargoType
    capacity
    }

class List{
detail
}


' Ajustando as posições das classes

Editor "1" -down- "1*" Map : create >
Editor "1" -- "1*" Scenario : create >
Editor "1" -right- "1*" City : add >
Editor "1" -- "1*" Industry : add >

Player "1" -right- "1*" Station : buy >
Player "1" -down- "1" Map : place elements >
Player "1" -- "1*" Trains : buy >
Player "1" - "1*" RailLines : build >
Player "1"---"*" StationUpgrade: buy >
Player"1"---"1" List:view >

Map "1" - "1" Size : has >
Map "1" -- "1*" Industry : contain >
Map "1" -- "1*" City : contain >
Map "1" -- "1*" RailLines : contain >

Industry "1*" -down- "1*" PrimarySectorIndustries : could be >
Industry "1*" -down- "1*" TransformingIndustries : could be >
Industry "*" -down- "1*" MixedIndustries : could be >
Industry "1" - "1" Location : have >
Industry "1*" -- "1*" Station : load/unload >
Industry "1" -- "1*" Cargo : produces >

Scenario "*" -- "1*" MixedIndustries : changes Class >
Scenario "*" -- "1*" Industry : changes Production >
Scenario "*" - "1" Map : have >
Scenario "*" - "1*" Trains : restrict >

MixedIndustries "*" -down- "*" PrimarySectorIndustries : transform >
MixedIndustries "*" -down- "*" TransformingIndustries : transform >

Station "1" -- "1" Location : has >
Station "1" - "1" RailLines : connect <
Station "1" -left- "*" StationUpgrade : upgrade <
Station "1*" -- "1*" Trains : Load/unload <
Station "1*" --- "1*" City : Load/unload >
Station "1" -- "1*" Cargo : assigned to <
Station "*"--- "1"List: contain <

Trains "1" -- "1*" RailLines : use >
Trains "1" -- "1*" Routes : follow >
Trains "1" -- "1" Locomotive : composed of >
Trains "1" -- "*" Carriage : composed of >
Trains"*"--right"1" List: contain <


Routes "1" -- "1*" RailLines : use >
Routes "1" -- "2*" Station : connect >

City -- HouseBlocks : contain >
City "1" -- "1" Location : has >

Simulator "1" -- "1*" Industry : start/pause >

@enduml

