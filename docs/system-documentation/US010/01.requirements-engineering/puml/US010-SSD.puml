@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : requests to assign a train to a route
    activate System

        System --> Player : shows list of owned trains
    deactivate System

    Player -> System : selects a train
    activate System

        System --> Player : shows list of available stations connected by railway lines
    deactivate System

    Player -> System : selects stations for the route
    activate System

        System --> Player : shows available cargoes at the selected stations
    deactivate System

    Player -> System : selects cargoes to be picked up
    activate System

        System --> Player : shows all selections and requests confirmation
    deactivate System

    Player -> System : confirms selections
    activate System

        System --> Player : displays operation success message
    deactivate System

deactivate Player
@enduml