@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":System" as System

activate Player

    Player -> System : requests to assign a train to a route
    activate System

        System --> Player : shows list of owned trains
    deactivate System

    Player -> System : selects a train
    activate System

        System --> Player : shows list of all stations and respective cargoes
    deactivate System

    Player -> System : selects stations for the route
    activate System

        System --> Player : asks for confirmation
    deactivate System

    Player -> System : confirms route
    activate System

        System --> Player : displays operation success message
    deactivate System

deactivate Player
@enduml
