@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model for US010 - Assign a Train to a Route

class Player {
}

class Train {
    name
}

class Locomotive {
     plateNumber
     powerSource
     acceleration
     buyCost
     startYear
     fuelCost
     maintenanceCost
}

class Carriage {
    cargoType
    capacity
}

class Route {
    starts
    ends
}

class Station {
    name
}

class Cargo {
    type
    quantity
}

Player "1" -- "*" Train : owns >
Train "1" -- "1" Route : follows >
Train "1" -- "1" Locomotive : is composed of >
Train "1" -- "*" Carriage : is composed of >
Route "1" -- "2*" Station : connects >
Station "1" -- "*" Cargo : is assigned to <
Carriage "*" -- "1" Cargo : transports >

@enduml
