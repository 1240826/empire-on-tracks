@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model for US010 - Assign a Train to a Route

class Player {
}

class Train {
    plateNumber
    name
}

class Locomotive {
    powerSource
    acceleration
    cost
}

class Carriage {
    cargoType
    capacity
}

class Route {
    starts
    ends
}

class Station {
    name
    range
    type
    cost
}

class Cargo {
    type
    quantity
    limit
}

Player "1" -- "*" Train : owns >
Train "1" -- "1" Route : is assigned to >
Train "1" -- "1" Locomotive : is composed of >
Train "1" -- "*" Carriage : is composed of >
Route "1" -- "2*" Station : connects >
Station "1" -- "*" Cargo : is assigned to <
Carriage "*" -- "1" Cargo : transports >

@enduml
