@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model for US010 - Assign a Train to a Route

class Player {
}

class Train {
    plateNumber
}

class Locomotive {
    powerSource
    acceleration
}

class Carriage {
    cargoType
    capacity
}

class Route {
    starts
    ends
}

class Station {
    name
    type
}

class Cargo {
    type
    quantity
}

Player "1" -- "*" Train : owns >
Train "1" -- "1" Route : assigned to >
Train "1" -- "1" Locomotive : powered by >
Train "1" -- "*" Carriage : composed of >
Route "1" -- "2*" Station : connects >
Station "1" -- "*" Cargo : assigned to >
Carriage "*" -- "1" Cargo : transports >

@enduml
