@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class AssignTrainToRouteUI {
    + run()
}

class AssignTrainToRouteController {
    + getOwnedTrains()
    + getStationsAndCargo()
    + assignRoute(trainId, stationCargoList)
    - validateRoute(stationCargoList)
    - createRoute(stationCargoList)
}

class TrainRepository {
    + getOwnedTrains()
    + findTrainById(id)
    + save(train)
}

class StationRepository {
    + getAllStationsAndCargo()
}

class RouteValidator {
    + validateRoute(stationCargoList)
}

class Route {
    + Route(stationCargoList)
}

class Train {
    + assignRoute(route)
}

AssignTrainToRouteUI .> AssignTrainToRouteController
AssignTrainToRouteController .> TrainRepository
AssignTrainToRouteController .> StationRepository
AssignTrainToRouteController .> RouteValidator
AssignTrainToRouteController .> Route
AssignTrainToRouteController .> Train

TrainRepository --> "*" Train
RouteValidator --> Route
Train  -->  Route

@enduml