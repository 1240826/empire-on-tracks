@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0

class AssignTrainToRouteUI {
    - controller: AssignTrainToRouteController
    + run()
}

class AssignTrainToRouteController {
    + getOwnedTrains() : List<Train>
    + getAvailableStations() : List<Station>
    + getAvailableCargoTypes() : List<CargoType>
    + parseRouteFromInput(input) : Route
    + assignRouteToTrain(trainIndex, route) : boolean

    ' Inner helper class
    class StationCargo {
        - station: Station
        - cargoType: CargoType
        + getStation()
        + getCargoType()
    }


class TrainRepository {
    - trains: List<Train>
    + getOwnedTrains() : List<Train>
    + findTrainById(id) : Train
    + save(train)
    }

class StationRepository {
    - stations: List<Station>
    + getAllStations() : List<Station>
}

class RouteValidator {
    + validateRoute(stationCargoList) : boolean
}

class RailLine {
    - stationA: Station
    - stationB: Station
    - isElectrified: boolean
    - isDoubleTrack: boolean
    + isConnected(stationA, stationB) : boolean
}

class Train {
    - plateNumber: String
    - name: String
    - assignedRoute: Route
    + assignRoute(route)
}

class Route {
    - stationCargoList: List<AssignTrainToRouteController.StationCargo>
    + Route(stationCargoList)
}

' Associations
AssignTrainToRouteUI           .> AssignTrainToRouteController
AssignTrainToRouteController   .> TrainRepository
AssignTrainToRouteController   .> StationRepository
AssignTrainToRouteController   .> RouteValidator
RouteValidator                 .> RailLine
TrainRepository                --> "*" Train
Train                          *--  Route

note right of Route
  stationCargoList uses the StationCargo
  inner helper class from AssignTrainToRouteController,
  not a domain class.
end note

@enduml
