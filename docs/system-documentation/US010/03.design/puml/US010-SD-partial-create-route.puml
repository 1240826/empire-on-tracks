@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":AssignTrainToRouteController" as Controller
participant ":RouteValidator"                   as Validator
participant ":RailLine"                         as RailLine
participant ":Route"                            as Route

autonumber 10.1

group CreateRoute
    Controller -> Validator : validateRoute(stationCargoList)
    activate Validator

    loop for each (stationA, stationB) in stationCargoList
        Validator -> RailLine : isConnected(stationA, stationB)
        RailLine --> Validator   : true/false
    end

    Validator --> Controller : route valid/invalid
    deactivate Validator

    alt if route valid
        Controller -> Route : createRoute(stationCargoList)
        activate Route
        Route --> Controller : route
        deactivate Route
    end
end
@enduml
