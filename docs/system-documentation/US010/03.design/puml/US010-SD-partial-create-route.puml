@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'hide footbox

participant ":AssignTrainToRouteController" as Controller
participant ":RouteValidator" as Validator
participant ":Route" as Route

autonumber 10
 -> Controller : assignRouteToTrain(trainId, stationCargoList)
autonumber 10.1
activate Controller
    group Create Route

        Controller -> Validator : validate route connectivity
        activate Validator
            Validator --> Controller : route valid/invalid
        deactivate Validator

        Controller -> Route : createRoute(stationCargoList)
        activate Route
            Route --> Controller : route
        deactivate Route

    end



@enduml
