@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

participant ":AssignTrainToRouteController" as Controller
participant ":TrainRepository"            as TrainRepo
participant ":Train"                      as Train

autonumber 10.7

group AssignRouteToTrain
    Controller -> TrainRepo : findTrainById(trainId)
    activate TrainRepo
    TrainRepo --> Controller : Train
    deactivate TrainRepo

    Controller -> Train : assignRoute(route)
    activate Train
    Train --> Controller : success
    deactivate Train

    Controller -> TrainRepo : save(train)
    activate TrainRepo
    TrainRepo --> Controller : saved
    deactivate TrainRepo
end
@enduml
