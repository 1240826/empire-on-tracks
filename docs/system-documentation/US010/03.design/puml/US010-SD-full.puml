@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor Player
participant ":AssignTrainToRouteUI" as UI
participant ":AssignTrainToRouteController" as Controller
participant ":TrainRepository" as TrainRepo
participant ":StationRepository" as StationRepo
participant ":RouteValidator" as RouteValidator
participant ":RailLine" as RailLine
participant ":Route" as Route
participant ":Train" as Train

activate Player
Player -> UI : request to assign a train to a route
activate UI

UI -> Controller : getOwnedTrains()
activate Controller
Controller -> TrainRepo : getOwnedTrains()
activate TrainRepo
TrainRepo --> Controller : list of owned trains
deactivate TrainRepo
Controller --> UI : list of owned trains
deactivate Controller

UI -> Player : display list of owned trains
Player -> UI : selects a train

UI -> Controller : getAllStationsAndCargo()
activate Controller
Controller -> StationRepo : getAllStationsAndCargo()
activate StationRepo
StationRepo --> Controller : list of stations and cargoes
deactivate StationRepo
Controller --> UI : list of stations and cargoes
deactivate Controller

UI -> Player : display list of stations and cargo
Player -> UI : selects stations and cargo

UI -> Controller : assignRouteToTrain(trainId, stationCargoList)
activate Controller
Controller -> RouteValidator : validateRoute(stationCargoList)
activate RouteValidator

loop for each (stationA, stationB) in stationCargoList
    RouteValidator -> RailLine : isConnected(stationA, stationB)
    note right of RailLine
        Checks if a direct line exists between each pair of stations.
    end note
    RailLine --> RouteValidator : true/false
end
' ===================================================

RouteValidator --> Controller : route valid/invalid
deactivate RouteValidator

alt if route is valid
    Controller -> Route : createRoute(stationCargoList)
    activate Route
    Route --> Controller : route
    deactivate Route

    Controller -> TrainRepo : findTrainById()
    activate TrainRepo
    TrainRepo --> Controller : Train
    deactivate TrainRepo

    Controller -> Train : assignRoute(route)
    activate Train
    Train --> Controller : success
    deactivate Train

    Controller -> TrainRepo : save(train)
    activate TrainRepo
    TrainRepo --> Controller : saved
    deactivate TrainRepo

    Controller --> UI : success message
else
    Controller --> UI : failure message
end

deactivate Controller
UI -> Player : show result

deactivate UI
deactivate Player
@enduml
