@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Organization\nEmployee" as Employee
participant ":System" as System

activate Employee

    Employee -> System : asks to upgrade the station
    activate System

        System --> Employee : asks what station should be upgraded
    deactivate System

    Employee -> System : selects a station
    activate System

        System --> Employee : asks what building to use for the upgrade
    deactivate System

    Employee -> System : chooses a building
    activate System

        System --> Employee : shows all data and requests confirmation
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : displays operation success
    deactivate System
@enduml