@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class "UpgradeStationController" {
    + startUpgrade()
    + selectStation(stationName: String)
    + chooseUpgrade(type: BuildingType)
    + confirmUpgrade(): boolean
}

class "Player" {
    - budget: double
    + applyUpgradeToStation(station: Station, type: BuildingType): boolean
}

class "Station" {
    - name: String
    - buildings: List<Building>
    + addBuilding(building: Building): void
    + hasBuildingType(type: BuildingType): boolean
}

class "Building" {
    - type: BuildingType
    + Building(type: BuildingType)
    + getType(): BuildingType
}

enum BuildingType {
    RESTAURANTE
    REFEITORIO
    SERVICO_POSTAL
    REPARACAO
    ALARGAMENTO
}

class "Map" {
    + getStationByName(name: String): Station
}

class "Repositories" {
    - Repositories()
    + {static} getInstance(): Repositories
    + getMapRepository(): MapRepository
}

class "MapRepository" {
    + getCurrentMap(): Map
}

class "UpgradeStationUI" {
    + requestStationSelection()
    + showUpgradeOptions()
    + showUpgradeSuccess()
    + showInvalidChoice()
    + showInsufficientBudget()
}

UpgradeStationUI .> UpgradeStationController : interacts >

UpgradeStationController ..> Repositories : accesses >
UpgradeStationController ..> MapRepository : accesses >
UpgradeStationController ..> Player : executes upgrade >
UpgradeStationController ..> Station : selected >
UpgradeStationController ..> Building : creates >

Repositories --> "1" MapRepository : mapRepository
MapRepository --> "1" Map : currentMap

Map --> "*" Station : stations
Station --> "*" Building : has >
Building --> BuildingType : has >

@enduml
