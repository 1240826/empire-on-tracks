@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

'title US12 - Cargo Generation Simulator (Domain Model)

class Simulator {
    isRunning
    start()
    pause()
    generateCargo()
}

class Station {
    name
    positionX
    positionY
}

class Industry {
    type
    positionX
    positionY
    productionRate
}

class City {
    name
    houseBlocks
    positionX
    positionY
}

class Cargo {
    type
    amount

}

' --- Relacionamentos ---
Simulator "1" -- "*" Cargo : generates >
Station "1" -- "*" Cargo : holds >

Industry "1" -- "*" Station : supplies >
City "1" -- "*" Station : demands >

Industry "1" -- "*" Cargo : produces >
City "1" -- "*" Cargo : consumes >

@enduml