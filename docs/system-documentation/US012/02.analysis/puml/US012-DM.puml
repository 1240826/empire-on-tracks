@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

'left to right direction

skinparam classAttributeIconSize 0

hide circle
hide methods

'title Domain Model

class ProductOwner {

}

class Simulation {
    status
    industries
    cities
    stations
    railroadNetworks
    scenarios
    map
}

class Industry {
    type
    sector
    location
    inventory
}

class City {
    name
    population
}

class Station {
    name
    location
    inventory
}

class RailroadNetwork {

    tracks
    routes
}

class Scenario {
    name
    data
    description
}

ProductOwner "1" -- "*" Simulation : creates
Simulation "1" -- "*" Industry : run
Simulation "1" -- "*" City : run
Simulation "1" -- "*" Station : run
Simulation "1" -- "*" RailroadNetwork : run
Simulation "1" -- "*" Scenario : run


@enduml
