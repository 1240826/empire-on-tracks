@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false
skinparam classAttributeIconSize 0
hide circle
hide methods

class Simulator{
isRunning
}
class Industry {
    production
}
class PrimarySectorIndustries{
    type
}
class TransformingIndustries{
    type
    demand
}
class MixedIndustries{
    type
}
class Station {
    name
    range
    type
    cost
}

class Cargo {
    type
    quantity
    limit
}
class HouseBlocks{
    people
}

class RailLines{
cost
type
}

class Location{
    positionX
    positionY
}


class City {
    numberOfHouseBlocks
    name
}

class Trains{
     type
     speed
     cargo
     cost
}

class Routes{
    starts
    ends
}

Simulator "1" -- "1*" Industry : start/pause >

Industry "1*" -- "1" PrimarySectorIndustries : could be >
Industry "1*" -- "1" TransformingIndustries : could be >
Industry "*" -- "1" MixedIndustries : could be >
Industry "1" -- "1*" Cargo : produces >
Industry "1*" -- "1*" Station : load/unload >
Industry "1" - "1" Location : have >

Station "1" - "1*" Cargo : assigned to <
Station "1" -- "1" Location : has >
Station "1" -left "1" RailLines : connect <
Station "1*" -- "1*" Trains : Load/unload <

Station "1*" -- "1*" HouseBlocks : Load/unload >

Trains "1" -- "1*" Routes : follow >

Routes "1" -- "1*" RailLines : use >
Routes "1" -- "2*" Station : connect >
City "1" -- "1" Location : has >
City "1"-left"1*" HouseBlocks : contain >
@enduml