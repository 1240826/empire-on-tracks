@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'====================
' CLASSES PRINCIPAIS
'====================

class SimulatorUI {
}

class "SimulatorController"{
    +start()
    +pause()
    +loadSimulator(map: Map, scenarioRepo: ScenarioRepository)
    +display()
}

class Map {
    +update()
}

class SimulationTime {
    +getDate()
    +advance()
}

class MapIndustry {
    +updateIndustries()
}

class MapStation {
    +updateStations()
}

class MapTrain {
    +updateTrains()
}

class ScenarioRepository {
    +changeScenario(date: LocalDateTime)
}

class Scenario {
    +changeProduction()
    +changeClassMixed()
    +transformIndustry()
}

'====================
' CLASSES DE INDÚSTRIA
'====================

interface Industry {
    +generateCargo()
}

class PrimarySectorIndustry {
    -type
    +generateCargo()
}

class TransformingIndustry {
    -type
    -demand
    +generateCargo()
    +consumeCargo()
}

class MixedIndustry {
    -type
    +generateCargo()
    +consumeCargo()
    +changeToPrimary()
    +changeToTransforming()
}

'====================
' RELACIONAMENTOS
'====================

SimulatorUI .> SimulatorController : uses

SimulatorController ..> Map : uses
SimulatorController ..> SimulationTime : uses
SimulatorController ..> ScenarioRepository : uses

Map *-- MapIndustry
Map *-- MapStation
Map *-- MapTrain

ScenarioRepository *-- Scenario

Scenario --> SimulationTime : consults
Scenario --> MapIndustry : modifies
Scenario --> MixedIndustry : transforms

' Herança das indústrias
Industry <|-- PrimarySectorIndustry
Industry <|-- TransformingIndustry
Industry <|-- MixedIndustry

' Transformação entre indústrias
MapIndustry --> Industry: contains

MixedIndustry ...|> PrimarySectorIndustry : changeToPrimary
MixedIndustry ..|> TransformingIndustry : changeToTransforming

@enduml
