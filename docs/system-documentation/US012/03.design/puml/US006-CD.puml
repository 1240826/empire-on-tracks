@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

'====================
' CLASSES PRINCIPAIS
'====================

class SimulatorUI {
}

class "SimulatorController"{
    +start()
    +pause()
    +loadSimulator(map: Map, scenarioRepo: ScenarioRepository)
    +display()
}

class Map {
    +update()
}

class SimulationTime {
    +getDate()
    +advance()
}

class IndustryRepository {
    +updateIndustries()
}

class StationRepository {
    +updateStations()
}

class TrainRepository {
    +updateTrains()
}

class ScenarioRepository {
    +changeScenario(date: LocalDateTime)
}

class Scenario {
    +changeProduction()
    +changeClassMixed()
    +disableTrains()
    +transformIndustry()
}

'====================
' CLASSES DE INDÚSTRIA
'====================

interface Producer {
    +generateCargo()
}

interface Consumer {
    +consumeCargo()
}

class Industry {
    +setProductionLevel()
}

class PrimarySectorIndustry {
    -type
    +generateCargo()
}

class TransformingIndustry {
    -type
    -demand
    +generateCargo()
    +consumeCargo()
}

class MixedIndustry {
    -type
    +generateCargo()
    +consumeCargo()
    +changeToPrimary()
    +changeToTransforming()
}

'====================
' RELACIONAMENTOS
'====================

SimulatorUI .> SimulatorController : uses

SimulatorController ..> Map : uses
SimulatorController ..> SimulationTime : uses
SimulatorController ..> ScenarioRepository : uses

Map *-- IndustryRepository
Map *-- StationRepository
Map *-- TrainRepository

ScenarioRepository *-- Scenario

Scenario --> SimulationTime : consults
Scenario --> IndustryRepository : modifies
Scenario --> MixedIndustry : transforms

' Herança das indústrias
Industry <|-- PrimarySectorIndustry
Industry <|-- TransformingIndustry
Industry <|-- MixedIndustry

PrimarySectorIndustry ..|> Producer
TransformingIndustry ..|> Producer
TransformingIndustry ..|> Consumer
MixedIndustry ..|> Producer
MixedIndustry ..|> Consumer

' Transformação entre indústrias
MixedIndustry ..|> PrimarySectorIndustry : changeToPrimary
MixedIndustry ..|> TransformingIndustry : changeToTransforming

@enduml
