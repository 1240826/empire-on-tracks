@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Owner
participant ":SimulatorUI" as UI
participant ":SimulatorController" as Controller
participant ":Map" as Map

participant "MapStations" as Rep_Stations
participant "MapStations \n :Station" as Stations

participant "MapIndustries" as Rep_Industries
participant "MapIndustries\n Industry" as Industries

participant "MapIndustries\n PrimaryIndustry" as PrimaryIndustry
participant "MapIndustries\n TransformingIndustry" as TransformingIndustry
participant "MapIndustries\n MixedIndustry" as MixedIndustry

participant "MapTrains" as Rep_Trains
participant "MapTrains \n Train" as Trains

participant ":SimulationTime" as Time
participant "RepositorieScenario" as Rep_Scenario
participant "RepositorieScenario\n Scenario" as Scenario

activate Owner

Owner -> UI : create simulation with industries, cities, stations, \n railroad networks, and scenarios
activate UI
UI -> Controller : loadSimulator(Map, Rep_Scenario)

UI --> Owner : ask if they want to start/pause
deactivate UI

loop Simulation
    alt Player selects "start"
        Owner -> UI : selects start
        activate UI
        UI -> Controller : start()

        loop
            activate Controller
            Controller -> Controller : updateMap(True)
            Controller -> Map : getMap()
            activate Map
            Map --> Controller : Map
            deactivate Map

            Controller -> Rep_Scenario : change()
            activate Rep_Scenario
            Rep_Scenario -> Time : getDate()
            activate Time
            Time --> Rep_Scenario : Date
            deactivate Time

            Rep_Scenario -> Scenario : activate()
            activate Scenario

            opt Scenario changes industry production
                Scenario -> Industries : changeProductionRate()
                end
                opt Industry is Mixed
                    Scenario -> MixedIndustry : changeToPrimary()
                    MixedIndustry --> MixedIndustry : demand(False)
                end
                opt Industry is Transforming
                    Scenario -> MixedIndustry : changeToTransforming()
                    MixedIndustry --> MixedIndustry : demand(true)
                end


            opt Scenario changes industry class (Mixed)
                Scenario -> Industries : changeClassMixed()
            end

            opt Scenario disables trains
                Scenario -> Trains : disable()
            end
            deactivate Scenario

            activate Map
            ' Atualização das indústrias (geração de carga)
            Controller -> Rep_Industries : updateIndustries()
            activate Rep_Industries
            Rep_Industries -> Industries : generateCargoAllStations()
            activate Industries
            Industries --> Industries : generateCargo()
            deactivate Industries
            deactivate Rep_Industries

            ' Atualização das estações (coleta até 24 cargas)
            Controller -> Rep_Stations : updateStations()
            activate Rep_Stations
            Rep_Stations -> Stations : findNearbyIndustries()
            activate Stations
            Stations -> Rep_Industries : getIndustriesInRange()
            activate Rep_Industries
            Rep_Industries --> Stations : listOfNearbyIndustries

            loop Station.cargo < 24
                Stations -> Industries : collectCargo()
                Industries --> Stations : Cargo
            end

            deactivate Rep_Industries
            deactivate Stations
            deactivate Rep_Stations

            ' Atualização dos trens (cada um com limite próprio)
            Controller -> Rep_Trains : updateTrains()
            activate Rep_Trains
            Rep_Trains -> Trains : move()
            activate Trains
            Trains -> Controller : hasStationNearby()

            opt station nearby
                Trains -> Stations : collectCargo()
                Stations --> Trains : Cargo
            end

            deactivate Trains
            deactivate Rep_Trains

            Controller --> Map : updatedMap
            deactivate Map

            Controller --> UI : display(updatedMap)
            Controller --> Time : addTime(True)

            deactivate Controller
        end

        UI --> Owner : simulation step completed
        deactivate UI

    else Player selects "pause"
        Owner -> UI : selects pause
        activate UI
        UI --> Controller : pause()
        activate Controller
            Controller -> Map : updateMap(False)
            activate Map
            Map --> Controller : Map
            deactivate Map
            Controller --> UI : display(Map)
            Controller --> Time : addTime(False)
        UI --> Owner : stop generating cargoes
        deactivate UI
    end
end

deactivate Owner
@enduml
