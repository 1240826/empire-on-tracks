@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Organization\nEmployee" as Employee
participant ":System" as System

activate Employee

    Employee -> System : wants to build a station
    activate System

        System --> Employee : asks for what type of station
    deactivate System

    Employee -> System : selects station
    activate System

        System --> Employee : asks to pick the coordinates
    deactivate System

    Employee -> System : types requested data
    activate System

        System --> Employee : shows the location of the station
    deactivate System

    Employee -> System : confirms data
    activate System

        System --> Employee : adds the city and confirms operation success
    deactivate System
@enduml