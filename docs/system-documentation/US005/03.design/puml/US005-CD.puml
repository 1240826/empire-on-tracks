@startuml
skinparam packageStyle rectangle
skinparam shadowing false
skinparam linetype polyline
skinparam classAttributeIconSize 0

class "BuildStationController" {
    + startBuildingStation()
    + submitStationDetails(name: String, type: StationType, x: int, y: int)
    + setStationCenter(orientation: String)  ' caso necessário
    + confirmStationCreation(): boolean
}

class "Player" {
    - budget: double
    + buildStation(name: String, type: StationType, location: Location, center: Location): Station
}

class "Station" {
    - name: String
    - type: StationType
    - location: Location
    - center: Location
    + create(name: String, type: StationType, location: Location, center: Location): Station
}

class "StationType" {
    - name: String
    - range: int
    - cost: double
}

class "Location" {
    - x: int
    - y: int
    + Location(x: int, y: int)
}

class "Map" {
    + isOccupied(location: Location): boolean
    + addStation(station: Station)
}

class "Repositories" {
    - Repositories()
    + {static} getInstance(): Repositories
    + getMapRepository(): MapRepository
}

class "MapRepository" {
    + getCurrentMap(): Map
}

class "BuildStationUI" {
    + requestStationDetails()
    + showInvalidCoordinates()
    + showSuccessMessage()
    + showInsufficientBudget()
}

BuildStationUI .> BuildStationController : interacts >

BuildStationController ..> Repositories : accesses >
BuildStationController ..> MapRepository : accesses >
BuildStationController ..> Player : requests action >
BuildStationController ..> Station : creates >
BuildStationController ..> Location : constructs >

Repositories --> "1" MapRepository : mapRepository
MapRepository --> "1" Map : currentMap

Map --> "*" Station : stations
Station --> "1" Location : location
Station --> "1" StationType : has >
Station --> "1" Location : center

@enduml
