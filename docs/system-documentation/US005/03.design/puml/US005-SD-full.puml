@startuml
skinparam monochrome true
skinparam packageStyle rectangle
skinparam shadowing false

autonumber

actor "Player" as Player
participant ":BuildStationUI" as UI
participant ":BuildStationController" as Controller
participant "Repositories" as REPOS
participant "repositories\n:Repositories" as REPOS_SINGLETON
participant "mapRepository\n:MapRepository" as MAP_REPO
participant ":Map" as Map
participant ":Station" as Station
participant ":StationType" as StationType
participant ":Location" as Location
participant ":Player" as PlayerObj
participant ":GameState" as GameState

activate Player

Player -> UI : wants to build a station
activate UI

    UI -> Controller : startBuild()
    activate Controller

        Controller -> REPOS : getInstance()
        activate REPOS
            REPOS --> Controller : repositories
        deactivate REPOS

        Controller -> REPOS_SINGLETON : getMapRepository()
        activate REPOS_SINGLETON
            REPOS_SINGLETON --> Controller : mapRepository
        deactivate REPOS_SINGLETON

        Controller -> MAP_REPO : getCurrentMap()
        activate MAP_REPO
            MAP_REPO --> Controller : currentMap
        deactivate MAP_REPO

        Controller -> UI : request station details\n(name, type, x, y, orientation)
    deactivate Controller
deactivate UI

UI --> Player : show station input form
Player -> UI : submits name, type, x, y, orientation
activate UI

    UI -> Controller : submitStationDetails(name, type, x, y, orientation)
    activate Controller

        Controller -> Map : isNameUnique(name)
        activate Map
            Map --> Controller : true / false
        deactivate Map

        alt name not unique
            Controller -> UI : showError("Station name already exists")
        else
            Controller -> StationType : retrieve(type)
            activate StationType
                StationType --> Controller : stationType
            deactivate StationType

            Controller -> Location : new(x, y)
            activate Location
                Location --> Controller : location
            deactivate Location

            Controller -> Map : isOccupied(location)
            activate Map
                Map --> Controller : true / false
            deactivate Map

            alt location is occupied
                Controller -> UI : showError("Location already occupied")
            else
                Controller -> PlayerObj : hasSufficientBudget(stationType.cost)
                activate PlayerObj
                    PlayerObj --> Controller : true / false
                deactivate PlayerObj

                alt insufficient budget
                    Controller -> UI : showError("Not enough budget")
                else
                    Controller -> Station : create(name, stationType, location, orientation)
                    activate Station
                        Station --> Controller : station
                    deactivate Station

                    Controller -> Map : addStation(station)
                    activate Map
                        Map -> Map : integrate station
                    deactivate Map

                    Controller -> PlayerObj : deductBudget(stationType.cost)

                    UI -> Map : highlightNewStation(station)

                    Controller -> GameState : save()

                    Controller -> UI : showSuccessMessage()
                end
            end
        end
    deactivate Controller
deactivate UI

deactivate Player
@enduml

